// Generates src/text/font_assets.gos: the bundled DejaVu faces as base64
// string constants, so every package that depends on gui embeds them
// without compile-time file access. Run from the repository root:
//
//     gos run tools/gen-fonts.gos

use std::fs
use std::encoding::base64

const FACES: [(String, String); 4] = [
    ("SANS", "assets/fonts/DejaVuSans.ttf")
    ("SANS_BOLD", "assets/fonts/DejaVuSans-Bold.ttf")
    ("MONO", "assets/fonts/DejaVuSansMono.ttf")
    ("MONO_BOLD", "assets/fonts/DejaVuSansMono-Bold.ttf")
]

fn main() {
    let mut out = "// Generated by tools/gen-fonts.gos from assets/fonts (DejaVu 2.37, see\n"
    out += "// licenses/dejavu-fonts.txt). Do not edit by hand.\n\n"
    for (name, file) in FACES {
        let bytes = fs::read(file).unwrap()
        out += f"pub (package) const {name}: String = \"{base64::encode(bytes)}\"\n\n"
    }
    fs::write("src/text/font_assets.gos", out.bytes()).unwrap()
    println("wrote src/text/font_assets.gos")
}
