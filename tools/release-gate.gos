// One release ledger for Rust, four execution tiers, native probes and artifacts.
// Usage: tools/release-gate.sh [OUT] [--profile portable|linux|native] [--group NAME] [--list]
// A group runs one share of the steps, so hosts can divide a profile between them.
use std::{env, errors, fs, os, path, process}
use std::crypto::sha256
use std::encoding::{json, toml}
use std::process::{Command, Stdio}
use std::time::Instant

const PROJECTS: [String; 3] = ["gui-gos", "windowing-gos", "gui-engine-gos"]
const EXCLUDED: [String; 9] = [
    ".git"
    ".gos-cache"
    "target"
    "dist"
    "reports"
    "__pycache__"
    "node_modules"
    ".ci-cache"
    ".ci-config"
]
const CROSS_TARGETS: [String; 3] = ["x86_64-pc-windows-msvc", "aarch64-apple-darwin", "x86_64-apple-darwin"]
const SETUP: String = "setup"
const EXAMPLE_GROUPS: i64 = 3

struct Step {
    name: String
    group: String
    cwd: String
    command: Vec<String>
    env: BTreeMap<String, String>
}

struct StepResult {
    name: String
    cwd: String
    command: Vec<String>
    env: BTreeMap<String, String>
    exit_code: i64
    seconds: f64
    log: String
    log_sha256: String
}

struct Ledger {
    toolchains: BTreeMap<String, String>
    rust_gate_toolchain: String
    revisions: BTreeMap<String, Option<String>>
    profile: String
    group: String
    host: String
    complete_release_acceptance: bool
    status: String
    coverage: String
    source_unchanged_during_gate: Option<bool>
    steps: Vec<StepResult>
}

struct Options {
    out: String
    profile: String
    group: String
    list: bool
}

#[cfg(target_os = "linux")]
fn system() -> String { "Linux" }

#[cfg(target_os = "macos")]
fn system() -> String { "Darwin" }

#[cfg(windows)]
fn system() -> String { "Windows" }

fn fail(message: String) -> errors::Error { errors::new(f"release-gate: {message}") }

fn parse_options() -> Result<Options, errors::Error> {
    let mut out = ""
    let mut profile = if system() == "Linux" { "linux" } else { "native" }
    let mut group = ""
    let mut list = false
    let args = env::args()
    let mut i = 0
    while i < args.len() {
        let arg = args[i]
        if arg == "--list" {
            list = true
        } else if arg == "--profile" && i + 1 < args.len() {
            profile = args[i + 1]
            i += 1
        } else if arg.starts_with("--profile=") {
            profile = arg.substring(10, arg.byte_len())
        } else if arg == "--group" && i + 1 < args.len() {
            group = args[i + 1]
            i += 1
        } else if arg.starts_with("--group=") {
            group = arg.substring(8, arg.byte_len())
        } else {
            if arg.starts_with("-") || !out.is_empty() {
                return Err(fail(f"usage: tools/release-gate.sh [OUT] [--profile portable|linux|native] [--group NAME] [--list]; unexpected {arg}"))
            }
            out = arg
        }
        i += 1
    }
    if profile != "portable" && profile != "linux" && profile != "native" {
        return Err(fail(f"unknown profile {profile}"))
    }
    Ok(Options { out: out, profile: profile, group: group, list: list })
}

fn absolute(p: String) -> Result<String, errors::Error> {
    if path::is_absolute(p) {
        return Ok(path::normalize(p))
    }
    Ok(path::normalize(path::join(env::current_dir()?, p)))
}

fn sorted_entries(dir: String) -> Result<Vec<fs::DirInfo>, errors::Error> {
    let mut entries = fs::read_dir(dir)?
    entries.sort_by_key(|e| e.name)
    Ok(entries)
}

fn hash_tree(root: String, dir: String, rows: &mut Vec<String>) -> Result<(), errors::Error> {
    let entries = sorted_entries(dir)?
    for entry in entries {
        if !entry.is_symlink && entry.is_file {
            let relative = entry.path.substring(root.byte_len() + 1, entry.path.byte_len())
            rows.push(f"{sha256::hex(fs::read(entry.path)?)}  {relative}")
        }
    }
    for entry in entries {
        if !entry.is_symlink && entry.is_dir && !EXCLUDED.contains(entry.name) {
            hash_tree(root, entry.path, rows)?
        }
    }
    Ok(())
}

fn source_hashes(root: String) -> Result<String, errors::Error> {
    let mut rows = #[]
    for project in PROJECTS {
        hash_tree(root, path::join(root, project), &mut rows)?
    }
    Ok(rows.join("\n") + "\n")
}

/// The files whose hash rows differ between two `source_hashes` manifests:
/// changed, added, or removed.
fn changed_files(before: String, after: String) -> Vec<String> {
    let old = before.lines().iter().collect::<Set<String>>()
    let new = after.lines().iter().collect::<Set<String>>()
    let mut files = BTreeSet::new()
    for row in old.iter().chain(new.iter()) {
        if !(old.contains(row) && new.contains(row)) {
            files.insert(row.substring(66, row.byte_len()))
        }
    }
    files.iter().collect()
}

/// Snapshots the bytes `live` holds now. A service that inherited the step's
/// output keeps writing only to `live`, so the sealed log never changes.
fn seal_log(live: String, destination: String) -> Result<(), errors::Error> {
    let size = fs::metadata(live)?.size
    let data = fs::read(live)?
    if data.len() < size {
        return Err(fail("step log shrank while sealing"))
    }
    let temporary = destination + ".tmp"
    fs::write(temporary, data[0..size])?
    fs::rename(temporary, destination)?
    Ok(())
}

fn which(tool: String) -> bool {
    if tool.contains("/") {
        return fs::is_file(tool)
    }
    let separator = if os::family() == "windows" { ";" } else { ":" }
    let suffix = if os::family() == "windows" { ".exe" } else { "" }
    let search = env::var("PATH").unwrap_or("")
    search.split(separator).any(|dir| !dir.is_empty() && fs::is_file(path::join(dir, tool + suffix)))
}

fn toml_value(file: String) -> Result<json::Value, errors::Error> {
    Ok(json::parse(toml::to_json(fs::read_to_string(file)?)?)?)
}

fn text(value: json::Value, key: String) -> String {
    json::get(value, key).and_then(|v| json::as_str(v)).unwrap_or("")
}

fn version_of(program: String, args: Vec<String>) -> String {
    match process::run(program, args) {
        Ok(out) => if out.code == 0 { out.stdout.trim() } else { out.stderr.trim() }
        Err(e) => f"{e}"
    }
}

fn host() -> String {
    if os::family() == "windows" {
        return f"Windows-{os::arch()}"
    }
    match process::run("uname", #["-srm"]) {
        Ok(out) => out.stdout.trim()
        Err(_) => f"{system()}-{os::arch()}"
    }
}

fn plan(gui: String, root: String, out: String, profile: String) -> Result<Vec<Step>, errors::Error> {
    let gos = env::var("GOS").unwrap_or("gos")
    let mut steps = #[]
    // Each step joins the group named last. Every group also runs the
    // `setup` steps, so its ledger records the dependencies it checked.
    let mut group = SETUP
    let add = |name: String, cwd: String, command: Vec<String>, environment: BTreeMap<String, String>| {
        steps.push(Step { name: name, group: group, cwd: cwd, command: command, env: environment })
    }
    let none = BTreeMap::new()
    let only = |key: String, value: String| {
        let mut m = BTreeMap::new()
        m.insert(key, value)
        m
    }
    add("tagged dependencies", gui, #["sh", "tools/fetch.sh"], none)
    group = "core"
    add("release evidence sealing", gui, #[gos, "test", "tools/release-gate.gos"], none)
    add("source policy", gui, #["sh", "tools/check-source-policy.sh"], none)
    group = "rust"
    if system() == "Linux" {
        add("Rust cores and bindings", gui, #["dbus-run-session", "--", "tools/check-rust.sh"], none)
    } else {
        add("Rust cores and bindings", gui, #["sh", "tools/check-rust.sh"], none)
    }
    for project in #["windowing-gos", "gui-gos"] {
        let directory = path::join(root, project)
        group = if project == "gui-gos" { "gui" } else { "core" }
        add(f"{project} quick-check", directory, #["sh", "quick-check.sh"], none)
        add(f"{project} unit tests", directory, #[gos, "test", "."], none)
        add(f"{project} four-tier parity", directory, #["sh", "tests/parity/run.sh"], none)
    }
    let reported = #[
        ("wrapper", "tests/wrap/run.sh", "GUI_WRAP_REPORT")
        ("toolkit platform", "tests/toolkit-platform/run.sh", "GUI_TOOLKIT_OUT")
        ("resources", "tests/resources/run.sh", "GUI_RESOURCE_REPORT")
        ("documents", "tests/documents/run.sh", "GUI_DOCUMENT_REPORT")
        ("screenshots", "tests/screenshots/run.sh", "GUI_SCREENSHOT_REPORT")
        ("memory lifetimes", "tests/memory/journeys/run.sh", "GUI_JOURNEY_OUT")
        ("performance budgets", "tests/perf/run.sh", "GUI_PERF_OUT")
    ]
    for (name, script, variable) in reported {
        group = if name == "screenshots" || name == "memory lifetimes" || name == "performance budgets" { "visuals" } else { "journeys" }
        add(name, gui, #["sh", script], only(variable, path::join(out, name.replace(" ", "-"))))
    }
    group = "visuals"
    add("scale journeys", gui, #["sh", "tests/scale/run.sh"], none)
    let mut examples = #["hello-world"]
    for entry in sorted_entries(path::join(gui, "examples"))? {
        let packaging = path::join(entry.path, "packaging.toml")
        if fs::is_file(packaging) && json::get(toml_value(packaging)?, "fixture").and_then(|v| json::as_bool(v)) != Some(false) {
            examples.push(entry.name)
        }
    }
    for (i, example) in examples.iter().enumerate() {
        group = f"examples-{i % EXAMPLE_GROUPS + 1}"
        add(f"example {example}", gui, #["sh", "tools/check-examples.sh", example], only("GUI_EXAMPLE_REPORT", path::join(out, "examples")))
    }
    group = "native"
    let windowing = path::join(root, "windowing-gos")
    add("single-instance four tiers", windowing, #["sh", "tests/instance/run.sh"], none)
    if profile == "linux" {
        add("native X11 Wayland platform and activation", windowing, #["sh", "tests/instance/native.sh"], only("WINDOWING_INSTANCE_REPORT", path::join(out, "native-platform")))
        add("native rendering and recovery", gui, #["sh", "tests/rendering/run.sh"], only("GUI_RENDER_OUT", path::join(out, "rendering")))
        for (name, script) in #[("native smoke", "tests/smoke/run.sh"), ("native XDND", "tests/xdnd/run.sh"), ("native Wayland drag", "tests/wldnd/run.sh"), ("native preferences", "tests/preferences/run.sh")] {
            add(name, windowing, #["sh", script], none)
        }
    } else if profile == "native" {
        let driver = if system() == "Windows" { "windows" } else { "cocoa" }
        let core = path::join(root, "windowing-gos/rust/gos-windowing")
        for example in #["instance-check", "platform-check"] {
            add(f"native {example}", core, #["cargo", "run", "--release", "--example", example], only("SDL_VIDEO_DRIVER", driver))
        }
        let toolkit = path::join(root, "gui-engine-gos/rust/gui-engine")
        add("native software default", toolkit, #["cargo", "run", "--release", "--example", "render-check", "--", "--require-software"], only("SDL_VIDEO_DRIVER", driver))
        let mut gpu = only("SDL_VIDEO_DRIVER", driver)
        gpu.insert("GUI_RENDERER", "gpu")
        add("native rendering and recovery", toolkit, #["cargo", "run", "--release", "--example", "render-check", "--", "--require-gpu"], gpu)
    }
    group = "packages"
    for target in CROSS_TARGETS {
        for project in #["gui-gos", "windowing-gos"] {
            let base = path::join(root, project)
            let mut directories = #[base]
            let examples = path::join(base, "examples")
            if fs::is_dir(examples) {
                for entry in sorted_entries(examples)? {
                    if fs::is_file(path::join(entry.path, "project.toml")) {
                        directories.push(entry.path)
                    }
                }
            }
            for directory in directories {
                let label = directory.substring(root.byte_len() + 1, directory.byte_len())
                add(f"{label} check {target}", directory, #[gos, "check", "--target", target, "."], none)
            }
        }
    }
    let mut apps = #[]
    for entry in sorted_entries(path::join(gui, "examples"))? {
        if fs::is_file(path::join(entry.path, "packaging.toml")) {
            apps.push(entry.name)
        }
    }
    let dist = path::join(out, "dist")
    for app in apps {
        add(f"package {app}", gui, #["sh", "tools/package.sh", f"examples/{app}", dist], none)
    }
    if profile == "linux" {
        // Every scripted application is exercised from the installed artifact.
        // The hello-world package is built but has no --fixture entry point.
        for app in apps {
            let packaging = toml_value(path::join(gui, f"examples/{app}/packaging.toml"))?
            if json::get(packaging, "fixture").and_then(|v| json::as_bool(v)) == Some(false) {
                continue
            }
            let manifest = path::join(gui, f"examples/{app}/project.toml")
            let Some(project) = json::get(toml_value(manifest)?, "project") else {
                return Err(fail(f"{manifest} has no [project] table"))
            }
            let id = text(project, "id")
            let exe = id.split("/").last().unwrap_or(id)
            let version = text(project, "version")
            let archive = path::join(dist, f"{exe}-{version}-linux-{os::arch()}.tar.gz")
            add(f"clean install {app}", gui, #["sh", "tools/clean-install.sh", archive], only("GUI_INSTALL_REPORT", path::join(out, f"install-{app}.json")))
        }
    }
    Ok(steps)
}

fn signal(child: &mut process::Child, number: i64) {
    if os::family() == "windows" {
        let _ = child.kill()
    } else {
        let _ = child.kill_group(number)
    }
}

fn stop(child: &mut process::Child) {
    // A step that already ended answers these signals with an error, which
    // the wait below makes moot.
    signal(child, 15)
    if let Ok(Some(_)) = child.wait_timeout(5000) {
        return
    }
    signal(child, 9)
    let _ = child.wait()
}

fn run_step(step: Step, base: BTreeMap<String, String>, live: String, limit_ms: i64) -> Result<i64, errors::Error> {
    // Both streams append to one log, so it reads in the order the step
    // wrote.
    fs::write(live, #[])?
    let append = || fs::OpenOptions::new().append(true).open(live)
    let mut command = Command::new(step.command[0])
        .args(step.command.iter().skip(1).collect())
        .dir(step.cwd)
        .env_remove("GUI_RENDERER")
        .stdout(Stdio::File(append()?))
        .stderr(Stdio::File(append()?))
        .stdin(Stdio::Null)
        .new_process_group()
    for (key, value) in base {
        command = command.env(key, value)
    }
    for (key, value) in step.env {
        command = command.env(key, value)
    }
    let mut child = command.spawn()?
    match child.wait_timeout(limit_ms)? {
        Some(code) => Ok(code)
        None => {
            stop(&mut child)
            Ok(124)
        }
    }
}

fn save(out: String, ledger: Ledger) -> Result<(), errors::Error> {
    fs::write(path::join(out, "results.json"), (json::encode_pretty(ledger) + "\n").bytes())?
    Ok(())
}

fn gate() -> Result<i64, errors::Error> {
    let options = parse_options()?
    let gui = path::parent(path::parent(fs::canonicalize(env::program_name())?).unwrap_or("")).unwrap_or("")
    let root = path::parent(gui).unwrap_or("")
    let out = if options.out.is_empty() { fs::temp_dir("gui-release-")? } else { absolute(options.out)? }
    let mut steps = plan(gui, root, out, options.profile)?
    if !options.group.is_empty() {
        if options.group == SETUP || !steps.any(|s| s.group == options.group) {
            return Err(fail(f"unknown group {options.group} in the {options.profile} profile"))
        }
        steps = steps.filter(|s| s.group == SETUP || s.group == options.group)
    }
    if options.list {
        for step in steps {
            println(json::encode(step))
        }
        return Ok(0)
    }
    fs::create_dir_all(out)?
    let evidence = path::join(out, "steps")
    fs::create_dir_all(evidence)?
    let gos = env::var("GOS").unwrap_or("gos")
    let mut missing = #[]
    for project in PROJECTS {
        if !fs::is_file(path::join(root, f"{project}/project.toml")) {
            missing.push(f"declared sibling checkout {project}")
        }
    }
    let mut required = #["cargo", "sh", gos]
    if options.profile == "linux" {
        required.extend(#["docker", "Xvfb", "sway", "weston", "Xephyr", "xdpyinfo", "xrdb", "dbus-run-session", "cc"])
    }
    for tool in required {
        if !which(tool) {
            missing.push(tool)
        }
    }
    if !missing.is_empty() {
        return Err(fail(f"missing release prerequisites: {missing.join(", ")}"))
    }
    let before = source_hashes(root)?
    fs::write(path::join(out, "source-sha256.txt"), before.bytes())?
    let mut base = BTreeMap::new()
    base.insert("SDL_VIDEO_DRIVER", "offscreen")
    base.insert("XDG_CONFIG_HOME", path::join(out, "config"))
    base.insert("XDG_CACHE_HOME", path::join(out, "cache"))
    // Steps that isolate their own XDG_CACHE_HOME still share one build of
    // each Rust binding set, which gos keys by its sources and profile.
    base.insert("GOSSAMER_CACHE", path::join(out, "cache"))
    let mut server: Option<process::Child> = None
    defer if let Some(mut x) = server { stop(&mut x) }
    let mut runtime_dir: Option<String> = None
    defer if let Some(dir) = runtime_dir { let _ = fs::remove_dir_all(dir) }
    if options.profile == "linux" {
        // A compositor's socket path is at most 108 bytes, so the runtime
        // directory sits at a short path of its own rather than in `out`.
        let runtime = f"/tmp/gui-gate-{process::id()}"
        fs::create_dir_mode(runtime, 0o700)?
        runtime_dir = Some(runtime)
        base.insert("XDG_RUNTIME_DIR", runtime)
        // Xvfb writes the display it chose to the descriptor -displayfd names.
        let log = fs::create(path::join(out, "xvfb.txt"))?
        let mut x = Command::new("Xvfb")
            .args(#["-displayfd", "1", "-screen", "0", "1280x900x24", "-nolisten", "tcp"])
            .stdout(Stdio::Piped)
            .stderr(Stdio::File(log))
            .stdin(Stdio::Null)
            .new_process_group()
            .spawn()?
        let display = x.read_stdout_line()?.unwrap_or("").trim()
        server = Some(x)
        if display.is_empty() || !display.chars().all(|c| c.is_ascii_digit()) {
            return Err(fail("private Xvfb failed to publish a display"))
        }
        base.insert("DISPLAY", ":" + display)
    }
    let mut revisions = BTreeMap::new()
    for project in PROJECTS {
        let revision = process::run_in("git", #["rev-parse", "HEAD"], path::join(root, project), #[])
        revisions.insert(project, match revision {
            Ok(r) => if r.code == 0 { Some(r.stdout.trim()) } else { None }
            Err(_) => None
        })
    }
    let mut toolchains = BTreeMap::new()
    toolchains.insert("gossamer", version_of(gos, #["--version"]))
    toolchains.insert("rust", version_of("rustc", #["--version"]))
    toolchains.insert("cargo", version_of("cargo", #["--version"]))
    let mut ledger = Ledger {
        toolchains: toolchains
        rust_gate_toolchain: env::var("RUSTUP_TOOLCHAIN").unwrap_or("1.95.0")
        revisions: revisions
        profile: options.profile
        group: options.group
        host: host()
        complete_release_acceptance: false
        status: "running"
        coverage: ""
        source_unchanged_during_gate: None
        steps: #[]
    }
    save(out, ledger)?
    let limit_ms = env::var("GUI_RELEASE_STEP_TIMEOUT").and_then(|s| s.to_i64()).unwrap_or(1800) * 1000
    let mut number = 0
    for step in steps {
        number += 1
        let started = Instant::now()
        let label = f"{number:02}"
        let log = path::join(evidence, f"{label}.txt")
        let live = path::join(evidence, f"{label}.live.txt")
        let code = run_step(step, base, live, limit_ms)?
        seal_log(live, log)?
        let seconds = (started.elapsed_ms() as f64) / 1000.0
        let result = StepResult {
            name: step.name
            cwd: step.cwd
            command: step.command
            env: step.env
            exit_code: code
            seconds: seconds
            log: f"steps/{label}.txt"
            log_sha256: sha256::hex(fs::read(log)?)
        }
        ledger.steps.push(result)
        save(out, ledger)?
        let verdict = if code == 0 { "PASS" } else { "FAIL" }
        println(f"{verdict} {step.name} ({seconds:.3}s): {log}")
    }
    // Each host contributes evidence. A portable-only or single-host run cannot
    // certify all supported OSes, even if every command it ran succeeded.
    let after = source_hashes(root)?
    let unchanged = after == before
    if !unchanged {
        fs::write(path::join(out, "source-sha256-after.txt"), after.bytes())?
        for file in changed_files(before, after) {
            println(f"CHANGED during the gate: {file}")
        }
    }
    let success = unchanged && ledger.steps.all(|r| r.exit_code == 0)
    ledger.status = if success { "pass" } else { "fail" }
    ledger.coverage = if options.profile == "portable" {
        "portable checks only"
    } else if !options.group.is_empty() {
        f"group {options.group} of the {system()} native host; the profile's other groups and other OS acceptance require their own ledgers"
    } else {
        f"{system()} native host; other OS acceptance requires their native ledgers"
    }
    ledger.source_unchanged_during_gate = Some(unchanged)
    save(out, ledger)?
    Ok(if success { 0 } else { 1 })
}

fn main() {
    match gate() {
        Ok(code) => process::exit(code)
        Err(e) => {
            eprintln(f"{e}")
            process::exit(1)
        }
    }
}

#[cfg(test)]
mod tests {
    use std::{errors, fs, path}
    use std::crypto::sha256
    use std::process::{Command, Stdio}

    #[test]
    fn changed_files_name_each_changed_added_and_removed_file_once() {
        let a = "1".repeat(64)
        let b = "2".repeat(64)
        let before = f"{a}  kept\n{a}  edited\n{a}  removed\n"
        let after = f"{a}  kept\n{b}  edited\n{a}  added\n"
        assert_eq(super::changed_files(before, after), #["added", "edited", "removed"])
    }

    #[test]
    fn a_step_log_holds_both_output_streams_in_the_order_written() -> Result<(), errors::Error> {
        let dir = fs::temp_dir("gui-step-")?
        defer fs::remove_dir_all(dir)
        let live = path::join(dir, "01.live.txt")
        let step = super::Step {
            name: "streams"
            group: "core"
            cwd: dir
            command: #["sh", "-c", "echo first; echo second >&2; echo third; exit 3"]
            env: BTreeMap::new()
        }
        assert_eq(super::run_step(step, BTreeMap::new(), live, 60_000)?, 3)
        assert_eq(fs::read_to_string(live)?, "first\nsecond\nthird\n")
        Ok(())
    }

    #[test]
    fn sealed_logs_keep_their_bytes_when_a_service_writes_after_its_step() -> Result<(), errors::Error> {
        let dir = fs::temp_dir("gui-release-")?
        defer fs::remove_dir_all(dir)
        let live = path::join(dir, "01.live.txt")
        let sealed = path::join(dir, "01.txt")
        // The service keeps the step's stdout after the step has returned; its
        // readiness line and stdin release order the writes without timing.
        let output = fs::create(live)?
        let mut child = Command::new("sh")
            .args(#["-c", "printf 'step complete\\n'; printf 'ready\\n' >&2; read line; printf 'late service shutdown\\n'"])
            .stdin(Stdio::Piped)
            .stdout(Stdio::File(output))
            .stderr(Stdio::Piped)
            .spawn()?
        assert_eq(child.read_stderr_line()?, Some("ready"))
        super::seal_log(live, sealed)?
        let recorded = sha256::hex(fs::read(sealed)?)
        assert(child.write_stdin("continue\n"))
        child.close_stdin()
        assert_eq(child.wait()?, 0)
        assert_eq(fs::read_to_string(sealed)?, "step complete\n")
        assert_eq(fs::read_to_string(live)?, "step complete\nlate service shutdown\n")
        assert_eq(sha256::hex(fs::read(sealed)?), recorded)
        fs::write(live, #[])?
        super::seal_log(live, sealed)?
        assert_eq(fs::read(sealed)?.len(), 0)
        assert(!fs::exists(sealed + ".tmp"))
        Ok(())
    }
}
