// Gregorian dates and time editors. Civil dates are independent of a timezone;
// conversion to an instant uses std::time's explicit DST gap/fold result.
use std::time
use crate::accessibility::{AccessNode, Role}
use crate::widgets::cx::Node
use crate::widgets::state::StateStore

#[derive(PartialEq, Eq)]
pub struct Date { pub year: i64, pub month: i64, pub day: i64 }

pub fn leap(year: i64) -> bool { year % 4 == 0 && (year % 100 != 0 || year % 400 == 0) }
pub fn month_days(year: i64, month: i64) -> i64 {
    match month { 2 => if leap(year) { 29 } else { 28 }, 4 | 6 | 9 | 11 => 30, 1 | 3 | 5 | 7 | 8 | 10 | 12 => 31, _ => 0 }
}
fn digits(text: String) -> bool { !text.is_empty() && text.chars().all(|c| c >= '0' && c <= '9') }
fn pad(value: i64, width: i64) -> String {
    let mut text = f"{value}"
    while text.byte_len() < width { text = "0" + text }
    text
}
impl Date {
    pub fn new(year: i64, month: i64, day: i64) -> Option<Date> {
        if year < 1 || year > 9999 || day < 1 || day > month_days(year, month) { return None }
        Some(Date { year: year, month: month, day: day })
    }
    pub fn parse(text: String) -> Option<Date> {
        if text.byte_len() != 10 || text.substring(4, 5) != "-" || text.substring(7, 8) != "-" { return None }
        if !digits(text.substring(0, 4)) || !digits(text.substring(5, 7)) || !digits(text.substring(8, 10)) { return None }
        Date::new(text.substring(0, 4).to_i64()?, text.substring(5, 7).to_i64()?, text.substring(8, 10).to_i64()?)
    }
    pub fn iso(&self) -> String { f"{pad(self.year, 4)}-{pad(self.month, 2)}-{pad(self.day, 2)}" }
    /// Day zero is Monday, 0001-01-01. Valid dates are in 0..3652059.
    pub fn ordinal(&self) -> i64 {
        let y = self.year - 1
        let mut days = y * 365 + y / 4 - y / 100 + y / 400 + self.day - 1
        for m in 1..self.month { days += month_days(self.year, m) }
        days
    }
    pub fn weekday(&self) -> i64 { self.ordinal() % 7 }
    pub fn add_days(&self, days: i64) -> Date {
        let target = (self.ordinal() + days.max(-3_652_059).min(3_652_059)).max(0).min(3_652_058)
        let mut lo = 1
        let mut hi = 10_000
        while lo + 1 < hi {
            let mid = (lo + hi) / 2
            if (Date { year: mid, month: 1, day: 1 }).ordinal() <= target { lo = mid } else { hi = mid }
        }
        let mut left = target - (Date { year: lo, month: 1, day: 1 }).ordinal()
        let mut month = 1
        while left >= month_days(lo, month) { left -= month_days(lo, month); month += 1 }
        Date { year: lo, month: month, day: left + 1 }
    }
    pub fn add_months(&self, months: i64) -> Date {
        let index = ((self.year - 1) * 12 + self.month - 1 + months.max(-120_000).min(120_000)).max(0).min(119_987)
        let year = index / 12 + 1
        let month = index % 12 + 1
        Date { year: year, month: month, day: self.day.min(month_days(year, month)) }
    }
}

#[derive(PartialEq, Eq)]
pub struct ClockTime { pub hour: i64, pub minute: i64, pub second: i64 }
impl ClockTime {
    pub fn parse(text: String) -> Option<ClockTime> {
        let parts = text.split(":")
        if parts.len() < 2 || parts.len() > 3 || parts[0].byte_len() != 2 || parts[1].byte_len() != 2 { return None }
        if parts.len() == 3 && parts[2].byte_len() != 2 { return None }
        for part in parts { if !digits(part) { return None } }
        let h = parts[0].to_i64()?
        let m = parts[1].to_i64()?
        let s = if parts.len() == 3 { parts[2].to_i64()? } else { 0 }
        if h < 0 || h > 23 || m < 0 || m > 59 || s < 0 || s > 59 { return None }
        Some(ClockTime { hour: h, minute: m, second: s })
    }
    pub fn iso(&self) -> String { f"{pad(self.hour, 2)}:{pad(self.minute, 2)}:{pad(self.second, 2)}" }
    pub fn seconds(&self) -> i64 { self.hour * 3600 + self.minute * 60 + self.second }
}

/// A nonnegative elapsed duration, independent of daylight-saving transitions.
pub fn parse_duration(text: String) -> Option<i64> {
    let parts = text.split(":")
    if parts.len() != 3 { return None }
    let h = parts[0].to_i64()?
    let m = parts[1].to_i64()?
    let s = parts[2].to_i64()?
    if h < 0 || m < 0 || m > 59 || s < 0 || s > 59 { return None }
    // Leave room for minutes and seconds before multiplying.
    if h > (i64::MAX - m * 60 - s) / 3600 { return None }
    Some(h * 3600 + m * 60 + s)
}

/// `HH:MM:SS` text for a duration in seconds, with negative durations as zero.
pub fn format_duration(seconds: i64) -> String {
    let s = seconds.max(0)
    f"{pad(s / 3600, 2)}:{pad((s / 60) % 60, 2)}:{pad(s % 60, 2)}"
}

/// Resolves in the named IANA timezone; never silently chooses a DST fold.
pub fn resolve_local(date: Date, clock: ClockTime, zone: String) -> Result<time::CivilResolution, String> {
    let location = time::Location::lookup(zone).map_err(|e| f"{e}")?
    location.resolve(time::CivilTime { year: date.year, month: date.month, day: date.day, hour: clock.hour, minute: clock.minute, second: clock.second, nanosecond: 0, offset_seconds: 0, weekday: 0 }).map_err(|e| f"{e}")
}

/// A single-selection calendar. Arrow keys move one day/week, Page Up/Down
/// one month (Control: one year), Home/End to week edges. Enter/Space selects.
#[derive(PartialEq)]
pub struct Calendar {
    pub id: String
    pub value: Date
    pub min: Date
    pub max: Date
    pub first_weekday: i64
    pub label: String
}
impl Calendar {
    pub fn new(id: String, value: Date) -> Calendar {
        Calendar { id: id, value: value, min: Date { year: 1, month: 1, day: 1 }, max: Date { year: 9999, month: 12, day: 31 }, first_weekday: 0, label: crate::localization::tr("Date") }
    }
    pub fn clamp(&self, date: Date) -> Date {
        if date.ordinal() < self.min.ordinal() { self.min } else if date.ordinal() > self.max.ordinal() { self.max } else { date }
    }
}
fn cursor(c: Calendar, st: StateStore) -> Date {
    if st.field(c.id, "external", "") != c.value.iso() { return c.clamp(c.value) }
    Date::parse(st.field(c.id, "cursor", "")).map(|d| c.clamp(d)).unwrap_or(c.clamp(c.value))
}
fn first(c: Calendar, date: Date) -> i64 {
    let d = Date { year: date.year, month: date.month, day: 1 }
    d.ordinal() - (d.weekday() - c.first_weekday.max(0).min(6) + 7) % 7
}
fn cell_date(start: i64, index: i64) -> Option<Date> {
    let ordinal = start + index
    if ordinal < 0 || ordinal > 3_652_058 { None } else { Some((Date { year: 1, month: 1, day: 1 }).add_days(ordinal)) }
}
fn weekday_names() -> Vec<String> {
    #["Mo", "Tu", "We", "Th", "Fr", "Sa", "Su"].map(|d| crate::localization::tr(d))
}
pub fn calendar_semantics(c: Calendar, n: Node, st: StateStore) -> Option<AccessNode> {
    let mut root = AccessNode::control(Role::Calendar, c.id, c.label, "")
    root.value = c.value.iso()
    let date = cursor(c, st)
    let start = first(c, date)
    for i in 0..42 {
        let Some(d) = cell_date(start, i) else { continue }
        let mut day = AccessNode::control(Role::Cell, f"{c.id}#{d.iso()}", d.iso(), "press")
        day.selected = d == c.value
        day.disabled = d.ordinal() < c.min.ordinal() || d.ordinal() > c.max.ordinal()
        day.focusable = false
        if n.parts.len() == 44 { day.bounds = n.parts[i + 2] }
        root.children.push(day)
    }
    Some(root)
}


/// Text editors share grapheme editing, IME, clipboard, undo and accessible text
/// with TextInput. A valid change emits Date; incomplete drafts stay local.
#[derive(PartialEq, Eq)]
pub enum TemporalKind { DateOnly, TimeOnly, DateAndTime, Elapsed }
#[derive(PartialEq)]
pub struct TemporalEditor {
    pub id: String
    pub value: String
    pub kind: TemporalKind
    pub min: String
    pub max: String
    pub label: String
}
impl TemporalEditor {
    pub fn new(id: String, value: String, kind: TemporalKind) -> TemporalEditor {
        TemporalEditor { id: id, value: value, kind: kind, min: "", max: "", label: crate::localization::tr("Date or time") }
    }
    pub fn canonical(&self, text: String) -> Option<String> {
        let result = canonical(self.kind, text)?
        let min = if self.min.is_empty() { None } else { Some(canonical(self.kind, self.min)?) }
        let max = if self.max.is_empty() { None } else { Some(canonical(self.kind, self.max)?) }
        if self.kind == TemporalKind::Elapsed {
            let value = parse_duration(result)?
            if let Some(lo) = min { if value < parse_duration(lo)? { return None } }
            if let Some(hi) = max { if value > parse_duration(hi)? { return None } }
        } else {
            if let Some(lo) = min { if result < lo { return None } }
            if let Some(hi) = max { if result > hi { return None } }
        }
        Some(result)
    }
}
pub fn canonical(kind: TemporalKind, text: String) -> Option<String> {
    match kind {
        TemporalKind::DateOnly => Some(Date::parse(text)?.iso())
        TemporalKind::TimeOnly => Some(ClockTime::parse(text)?.iso())
        TemporalKind::Elapsed => Some(format_duration(parse_duration(text)?))
        TemporalKind::DateAndTime => {
            let p = text.split("T")
            if p.len() != 2 { return None }
            Some(f"{Date::parse(p[0])?.iso()}T{ClockTime::parse(p[1])?.iso()}")
        }
    }
}
fn input(t: TemporalEditor) -> crate::widgets::textinput::TextInput {
    let hint = match t.kind { TemporalKind::DateOnly => "YYYY-MM-DD", TemporalKind::TimeOnly => "HH:MM:SS", TemporalKind::DateAndTime => "YYYY-MM-DDTHH:MM:SS", TemporalKind::Elapsed => "hours:minutes:seconds" }
    let mut field = crate::widgets::textinput::TextInput::new(t.id, t.value, hint, crate::widgets::textinput::InputKind::Line)
    field.label = t.label
    field.max_length = 32
    field.validated(|text| {
        if t.canonical(text).is_some() { return crate::editing::Validity::Valid }
        let complete = match t.kind { TemporalKind::DateOnly => text.byte_len() >= 10, TemporalKind::TimeOnly => text.byte_len() >= 5, TemporalKind::DateAndTime => text.byte_len() >= 16, TemporalKind::Elapsed => text.split(":").len() >= 3 }
        let why = f"Enter {hint} within the allowed range"
        if complete { crate::editing::Validity::Invalid(why) } else { crate::editing::Validity::Intermediate(why) }
    })
}
pub fn editor_semantics(t: TemporalEditor, st: StateStore) -> Option<AccessNode> {
    crate::widgets::textinput::input_semantics(input(t), st)
}
