// find: the find and replace bar. The application owns a `FindBar`, folds
// its messages through `FindBar::update`, runs the search the answered
// request names over its own text (`editing::search`), selects the result
// with `Effect::SelectText`, and records the count with `FindBar::found`.

use crate::editing::search::SearchOptions
use crate::localization
use crate::localization::tr
use crate::render::icons::Icon
use crate::widgets::Widget
use crate::widgets::completion::{Completion, CompletionItem, MatchMode}
use crate::widgets::cx::UiMsg
use crate::widgets::textinput::{InputKind, TextInput}

// The searches a bar remembers, newest first.
const HISTORY: i64 = 20

/// What the application does after a find bar message.
#[derive(Debug, PartialEq, Eq)]
pub enum FindRequest {
    /// Nothing beyond showing the bar again.
    Nothing
    /// The query or an option changed: recount and select the first match from the caret.
    Search
    /// Select the next match after the selection.
    Next
    /// Select the match before the selection.
    Previous
    /// Replace the selection when it is a match, then select the next one.
    Replace
    /// Replace every match as one edit.
    ReplaceAll
    /// The bar closed: give focus back to the document.
    Close
}

/// One find bar's state.
#[derive(Debug, PartialEq)]
pub struct FindBar {
    pub id: String
    pub open: bool
    /// Whether the replacement row shows.
    pub replacing: bool
    pub query: String
    pub replacement: String
    pub options: SearchOptions
    /// Matches in the searched text.
    pub count: i64
    /// The selected match's index, or -1 when the selection is not a match.
    pub current: i64
    /// Queries searched for, newest first, which the query field offers.
    pub history: Vec<String>
}

impl FindBar {
    /// A closed bar whose controls use ids beginning with `id`.
    pub fn new(id: String) -> FindBar {
        FindBar { id: id, open: false, replacing: false, query: "", replacement: "", options: SearchOptions::default(), count: 0, current: -1, history: #[] }
    }

    /// Opens the bar, with the replacement row when `replacing`.
    pub fn show(&mut self, replacing: bool) {
        self.open = true
        self.replacing = replacing
    }

    /// The query field's id, to focus when the bar opens.
    pub fn query_id(&self) -> String {
        f"{self.id}:query"
    }

    /// Records a search result: the number of matches and the selected one (-1 for none).
    pub fn set_matches(&mut self, count: i64, current: i64) {
        self.count = count.max(0)
        self.current = if current >= 0 && current < self.count { current } else { -1 }
    }

    /// Remembers the current query as the newest search.
    pub fn remember(&mut self) {
        if self.query.is_empty() { return }
        let query = self.query
        let mut kept = #[query]
        for q in self.history {
            if q != query && kept.len() < HISTORY { kept.push(q) }
        }
        self.history = kept
    }

    /// "2 of 5", "5 matches", "No matches", or "" before anything is typed.
    pub fn summary(&self) -> String {
        if self.query.is_empty() {
            return ""
        }
        if self.count == 0 {
            return tr("No matches")
        }
        if self.current < 0 {
            return localization::message("find", if self.count == 1 { "{count} match" } else { "{count} matches" }, self.count, Map::new())
        }
        localization::message("find", "{current} of {count}", self.count, { "current": f"{self.current + 1}" })
    }

    /// Folds one message into the bar and answers the work it asks for;
    /// messages for other widgets answer `Nothing`.
    pub fn update(&mut self, msg: UiMsg) -> FindRequest {
        let prefix = f"{self.id}:"
        match msg {
            UiMsg::TextChanged(id, text) => {
                if id == f"{prefix}query" {
                    if text == self.query { return FindRequest::Nothing }
                    self.query = text
                    return FindRequest::Search
                }
                if id == f"{prefix}replacement" { self.replacement = text }
                FindRequest::Nothing
            }
            UiMsg::Submitted(id, _) => {
                if id == f"{prefix}query" {
                    self.remember()
                    FindRequest::Next
                } else if id == f"{prefix}replacement" { FindRequest::Replace } else { FindRequest::Nothing }
            }
            UiMsg::Toggled(id, on) => {
                if id == f"{prefix}case" {
                    self.options.match_case = on
                    FindRequest::Search
                } else if id == f"{prefix}word" {
                    self.options.whole_word = on
                    FindRequest::Search
                } else if id == f"{prefix}regex" {
                    self.options.regex = on
                    FindRequest::Search
                } else {
                    FindRequest::Nothing
                }
            }
            UiMsg::Clicked(id) => {
                if !id.starts_with(prefix) {
                    return FindRequest::Nothing
                }
                match id.substring(prefix.byte_len(), id.byte_len()) {
                    "previous" => {
                        self.remember()
                        FindRequest::Previous
                    }
                    "next" => {
                        self.remember()
                        FindRequest::Next
                    }
                    "replace" => FindRequest::Replace
                    "replace-all" => FindRequest::ReplaceAll
                    "close" => {
                        self.open = false
                        FindRequest::Close
                    }
                    _ => FindRequest::Nothing
                }
            }
            _ => FindRequest::Nothing
        }
    }

    /// The bar's widgets; nothing while it is closed.
    pub fn view(&self) -> Widget {
        if !self.open {
            return Widget::Empty
        }
        let mut query = TextInput::new(self.query_id(), self.query, tr("Find"), InputKind::Search)
        query.label = tr("Find")
        if !self.history.is_empty() {
            query.completion = Some(Completion::local(self.history.map(|q| CompletionItem::new(q, q)), MatchMode::Substring))
        }
        let found = !self.query.is_empty() && self.count > 0
        // Options and steps show short faces, named in full for tooltips and
        // assistive technology, so the query keeps its room in a narrow window.
        let option = |key: String, face: String, name: String, on: bool| Widget::toggle_button(f"{self.id}:{key}", face, on).tooltip(name).accessible(name)
        let mut rows = #[Widget::row(#[
            Widget::input(query).grow(1)
            option("case", "Aa", tr("Match case"), self.options.match_case)
            option("word", "W", tr("Whole words"), self.options.whole_word)
            option("regex", ".*", tr("Regular expression"), self.options.regex)
            Widget::muted(self.summary()).min_width(72)
            Widget::tool_button(f"{self.id}:previous", Icon::ChevronUp, tr("Previous")).disabled(!found)
            Widget::tool_button(f"{self.id}:next", Icon::ChevronDown, tr("Next")).disabled(!found)
            Widget::tool_button(f"{self.id}:close", Icon::Close, tr("Close"))
        ], 4)]
        if self.replacing {
            let mut replacement = TextInput::new(f"{self.id}:replacement", self.replacement, tr("Replace with"), InputKind::Line)
            replacement.label = tr("Replace with")
            rows.push(Widget::row(#[
                Widget::input(replacement).grow(1)
                Widget::button(f"{self.id}:replace", tr("Replace")).disabled(!found)
                Widget::button(f"{self.id}:replace-all", tr("Replace All")).disabled(!found)
            ], 6))
        }
        Widget::column(rows, 6).padding_xy(8, 6).role(crate::accessibility::Role::Group).accessible(tr("Find and replace"))
    }
}

#[cfg(test)]
mod tests {
    use super::{FindBar, FindRequest}
    use crate::widgets::cx::UiMsg

    #[test]
    fn a_bar_remembers_searches_newest_first_without_repeats() {
        let mut bar = FindBar::new("find")
        for q in #["alpha", "beta", "alpha"] {
            bar.update(UiMsg::TextChanged("find:query", q))
            assert_eq(bar.update(UiMsg::Submitted("find:query", q)), FindRequest::Next)
        }
        assert_eq(bar.history, #["alpha", "beta"])
        bar.update(UiMsg::TextChanged("find:query", ""))
        bar.update(UiMsg::Clicked("find:next"))
        assert_eq(bar.history, #["alpha", "beta"])
    }
}
