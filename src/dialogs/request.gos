// request: typed dialog requests. Each names the dialog with an id that
// comes back in exactly one `UiMsg::Dialog(id, outcome)`.

use crate::editing::Validity
use crate::style::color::Color

/// How serious a message is; shown with an icon and in text, never by
/// color alone.
#[derive(PartialEq, Eq)]
pub enum Severity {
    Info
    Warning
    Error
    Confirmation
}

/// What a toolkit dialog blocks while it is open.
#[derive(PartialEq, Eq)]
pub enum Modality {
    /// The window it opens in.
    Window
    /// Every window of the application.
    Application
    /// Nothing: the window stays usable, and F6 moves focus between the
    /// window and its modeless dialogs.
    Modeless
}

/// The role of a dialog button: it decides placement, Enter/Escape
/// behavior, and styling.
#[derive(PartialEq, Eq)]
pub enum ButtonRole {
    /// Accepts (OK, Save, Open); Enter activates the default one.
    Accept
    /// Rejects without discarding (Cancel); Escape and the close box use it.
    Reject
    /// Destructive (Discard, Delete); never the default, never Escape.
    Destructive
    /// Applies without closing.
    Apply
    Help
    /// Anything else (Retry, Copy details).
    Other
}

/// One dialog button: a typed action id, its label, and its role.
#[derive(PartialEq, Eq)]
pub struct DialogAction {
    pub id: String
    pub label: String
    pub role: ButtonRole
}

impl DialogAction {
    pub fn new(id: String, label: String, role: ButtonRole) -> DialogAction {
        DialogAction { id: id, label: crate::localization::tr(label), role: role }
    }
}

/// What an input dialog collects.
pub enum InputSpec {
    Text
    Multiline
    Password
    /// A number within bounds; `step` for the spin arrows.
    Number(f64, f64, f64)
    /// One (or several, when `multiple`) of the (key, label) options.
    Choice(Vec<(String, String)>, bool)
}

impl PartialEq for InputSpec {
    fn eq(&self, other: InputSpec) -> bool {
        match (self, other) {
            (InputSpec::Text, InputSpec::Text) |
                (InputSpec::Multiline, InputSpec::Multiline) |
                (InputSpec::Password, InputSpec::Password) => true
            (InputSpec::Number(a, b, c), InputSpec::Number(d, e, f)) => a == d && b == e && c == f
            (InputSpec::Choice(a, m), InputSpec::Choice(b, n)) => a == b && m == n
            _ => false
        }
    }
}

/// Which file dialog.
#[derive(PartialEq, Eq)]
pub enum FileMode {
    Open
    OpenMany
    Save
    Folder
    FolderMany
}

/// Which implementation shows a file dialog.
#[derive(PartialEq, Eq)]
pub enum FileBackend {
    /// Native when it can meet every requirement, else the toolkit dialog.
    Auto
    /// The platform dialog; unmet requirements answer `Unsupported`.
    Native
    /// The toolkit's own dialog with favorites and recent locations.
    Toolkit
}

/// A named set of file patterns (`*.txt`, `*.gos`).
#[derive(PartialEq, Eq)]
pub struct FileFilter {
    pub name: String
    pub patterns: Vec<String>
}

/// What a date/time picker edits.
#[derive(PartialEq, Eq)]
pub enum DateMode {
    Date
    Time
    DateTime
}

/// One page of a preferences dialog: fields of (key, label, kind, value).
#[derive(PartialEq)]
pub struct PreferencePage {
    pub key: String
    pub title: String
    pub fields: Vec<PreferenceField>
}

/// One preference.
#[derive(PartialEq)]
pub struct PreferenceField {
    pub key: String
    pub label: String
    pub kind: PreferenceKind
    pub value: String
    pub default: String
    pub help: String
}

#[derive(PartialEq)]
pub enum PreferenceKind {
    Toggle
    Text
    Number(f64, f64)
    /// A whole number from the first bound to the second.
    Integer(i64, i64)
    Choice(Vec<(String, String)>)
    Color
}

/// One page of a wizard; `skip_if` names a field whose "true" value skips
/// the page (conditional steps).
#[derive(PartialEq)]
pub struct WizardPage {
    pub key: String
    pub title: String
    pub description: String
    pub fields: Vec<PreferenceField>
    pub skip_if: String
}

/// A dialog to show.
pub enum DialogRequest {
    /// An information, warning, error, or question message with typed
    /// actions. `detail` is expandable, selectable, and copyable.
    Message {
        id: String
        severity: Severity
        title: String
        message: String
        detail: String
        actions: Vec<DialogAction>
    }
    Input {
        id: String
        title: String
        label: String
        initial: String
        spec: InputSpec
        /// The host id of the judge of the draft.
        validate: Option<i64>
    }
    Color { id: String, title: String, initial: Color, alpha: bool }
    Font { id: String, title: String, initial: String }
    Date { id: String, title: String, initial: String, mode: DateMode, min: String, max: String }
    Shortcut { id: String, title: String, initial: String, reserved: Vec<String> }
    /// Progress with optional cancellation; update it with a new request
    /// of the same id, close it with `close_dialog`.
    Progress { id: String, title: String, message: String, value: f64, cancellable: bool }
    File {
        id: String
        mode: FileMode
        title: String
        directory: String
        name: String
        filters: Vec<FileFilter>
        backend: FileBackend
        /// Keys the remembered directory, filter, and recent locations.
        purpose: String
        /// Needs the application-managed favorites sidebar.
        needs_favorites: bool
    }
    /// `checked` dialogs ask the application before Apply, OK, Next or
    /// Finish takes effect (see `checked`).
    Preferences { id: String, title: String, pages: Vec<PreferencePage>, checked: bool }
    Wizard { id: String, title: String, pages: Vec<WizardPage>, checked: bool }
    /// A few fields over Cancel and an accept button labelled `accept`,
    /// answered as `Outcome::Values` keyed by field.
    Form { id: String, title: String, fields: Vec<PreferenceField>, accept: String }
    About { id: String, name: String, version: String, description: String, credits: String, licenses: String, diagnostics: String, links: Vec<(String, String)> }
}

impl DialogRequest {
    /// The request's id.
    pub fn id(&self) -> String {
        match self {
            DialogRequest::Message { id, .. } |
                DialogRequest::Input { id, .. } |
                DialogRequest::Color { id, .. } |
                DialogRequest::Font { id, .. } |
                DialogRequest::Date { id, .. } |
                DialogRequest::Shortcut { id, .. } |
                DialogRequest::Progress { id, .. } |
                DialogRequest::File { id, .. } |
                DialogRequest::Preferences { id, .. } |
                DialogRequest::Wizard { id, .. } |
                DialogRequest::Form { id, .. } |
                DialogRequest::About { id, .. } => *id
        }
    }

    /// The title the dialog's frame shows.
    pub fn title(&self) -> String {
        match self {
            DialogRequest::Message { title, .. } |
                DialogRequest::Input { title, .. } |
                DialogRequest::Color { title, .. } |
                DialogRequest::Font { title, .. } |
                DialogRequest::Date { title, .. } |
                DialogRequest::Shortcut { title, .. } |
                DialogRequest::Progress { title, .. } |
                DialogRequest::File { title, .. } |
                DialogRequest::Preferences { title, .. } |
                DialogRequest::Wizard { title, .. } |
                DialogRequest::Form { title, .. } => *title
            DialogRequest::About { name, .. } => crate::localization::message("about", "About {name}", 1, { "name": name })
        }
    }
}

// ---- convenience constructors ----

fn message(id: String, severity: Severity, title: String, text: String, actions: Vec<DialogAction>) -> DialogRequest {
    DialogRequest::Message { id: id, severity: severity, title: title, message: text, detail: String::new(), actions: actions }
}

/// An acknowledgement: a message and OK.
pub fn info(id: String, title: String, text: String) -> DialogRequest {
    message(id, Severity::Info, title, text, #[DialogAction::new("ok", "OK", ButtonRole::Accept)])
}

/// A consequence the user should weigh, with Continue and Cancel.
pub fn warning(id: String, title: String, text: String) -> DialogRequest {
    message(id, Severity::Warning, title, text, #[
        DialogAction::new("continue", "Continue", ButtonRole::Accept)
        DialogAction::new("cancel", "Cancel", ButtonRole::Reject)
    ])
}

/// A failure with the actions the caller supports (default: Close).
pub fn error(id: String, title: String, text: String, detail: String, retry: bool) -> DialogRequest {
    let mut actions = #[]
    if retry { actions.push(DialogAction::new("retry", "Retry", ButtonRole::Accept)) }
    actions.push(DialogAction::new("close", "Close", if retry { ButtonRole::Reject } else { ButtonRole::Accept }))
    DialogRequest::Message { id: id, severity: Severity::Error, title: title, message: text, detail: detail, actions: actions }
}

/// A yes/no style confirmation with caller labels; the safe choice is
/// the default and Escape answers `Cancelled`.
pub fn confirm(id: String, title: String, text: String, accept: String, destructive: bool) -> DialogRequest {
    message(id, Severity::Confirmation, title, text, #[
        DialogAction::new("accept", accept, if destructive { ButtonRole::Destructive } else { ButtonRole::Accept })
        DialogAction::new("cancel", "Cancel", ButtonRole::Reject)
    ])
}

/// Replace an existing file?
pub fn confirm_overwrite(id: String, name: String) -> DialogRequest {
    message(id, Severity::Warning, crate::localization::tr("Replace file?"), crate::localization::message("files", "\u{201C}{name}\u{201D} already exists. Replacing it overwrites its contents.", 1, { "name": name }), #[
        DialogAction::new("replace", "Replace", ButtonRole::Destructive)
        DialogAction::new("cancel", "Cancel", ButtonRole::Reject)
    ])
}

/// Delete permanently?
pub fn confirm_delete(id: String, name: String) -> DialogRequest {
    message(id, Severity::Warning, crate::localization::tr("Delete?"), crate::localization::message("files", "\u{201C}{name}\u{201D} will be deleted. This cannot be undone.", 1, { "name": name }), #[
        DialogAction::new("delete", "Delete", ButtonRole::Destructive)
        DialogAction::new("cancel", "Cancel", ButtonRole::Reject)
    ])
}

/// Save changes before closing? Save, Discard, or Cancel; closing the
/// prompt never means Discard.
pub fn confirm_unsaved(id: String, name: String) -> DialogRequest {
    message(id, Severity::Warning, crate::localization::tr("Save changes?"), crate::localization::message("files", "\u{201C}{name}\u{201D} has changes that are not saved.", 1, { "name": name }), #[
        DialogAction::new("save", "Save", ButtonRole::Accept)
        DialogAction::new("discard", "Don\u{2019}t Save", ButtonRole::Destructive)
        DialogAction::new("cancel", "Cancel", ButtonRole::Reject)
    ])
}

/// A one-line text prompt.
pub fn prompt(id: String, title: String, label: String, initial: String) -> DialogRequest {
    DialogRequest::Input { id: id, title: title, label: label, initial: initial, spec: InputSpec::Text, validate: None }
}

/// A filtered list of (key, label) options. A single choice answers
/// `Outcome::Action(key)`; with `multiple`, rows are checked and OK answers
/// `Outcome::Keys` in the options' order.
pub fn choose(id: String, title: String, label: String, options: Vec<(String, String)>, multiple: bool) -> DialogRequest {
    DialogRequest::Input { id: id, title: title, label: label, initial: "", spec: InputSpec::Choice(options, multiple), validate: None }
}

/// Asks whether `origin` may use `what` (notifications, location, ...).
/// Answers `Outcome::Action("allow")` or `Action("deny")`; Escape denies.
pub fn permission(id: String, origin: String, what: String) -> DialogRequest {
    let tr = crate::localization::tr
    message(id, Severity::Confirmation, tr("Permission requested"), crate::localization::message("permission", "{origin} asks to use {what}.", 1, { "origin": origin, "what": what }), #[
        DialogAction::new("deny", "Don't Allow", ButtonRole::Reject)
        DialogAction::new("allow", "Allow", ButtonRole::Accept)
    ])
}

/// A go-to dialog for a document of `lines` lines. It answers
/// `Outcome::Text` holding "line" or "line:column", both counted from 1;
/// `parse_location` reads it back.
pub fn go_to_line(id: String, lines: i64, initial: String) -> DialogRequest {
    let label = crate::localization::message("goto", "Line (1 to {count}), or line:column", lines, Map::new())
    DialogRequest::Input { id: id, title: crate::localization::tr("Go to Line"), label: label, initial: initial, spec: InputSpec::Text, validate: Some(crate::app::host::validator(|text| location_validity(text, lines))) }
}

/// The 1-based line and column of a "line" or "line:column" answer; the
/// column is 1 when absent. None when either part is not a positive integer.
pub fn parse_location(text: String) -> Option<(i64, i64)> {
    let parts = text.trim().split(":")
    if parts.len() > 2 {
        return None
    }
    let line = parts[0].trim().to_i64()?
    let column = if parts.len() == 2 { parts[1].trim().to_i64()? } else { 1 }
    if line < 1 || column < 1 { None } else { Some((line, column)) }
}

fn location_validity(text: String, lines: i64) -> Validity {
    if text.trim().is_empty() {
        return Validity::Intermediate(crate::localization::tr("Enter a line number"))
    }
    match parse_location(text) {
        Some((line, _)) => {
            if line <= lines { Validity::Valid } else { Validity::Invalid(crate::localization::message("goto", "The document has {count} lines", lines, Map::new())) }
        }
        None => Validity::Invalid(crate::localization::tr("Enter a line number, or line:column"))
    }
}

pub fn color(id: String, title: String, initial: Color) -> DialogRequest {
    DialogRequest::Color { id: id, title: title, initial: initial, alpha: true }
}

/// Open one file.
pub fn open_file(id: String, title: String, filters: Vec<FileFilter>) -> DialogRequest {
    DialogRequest::File { id: id, mode: FileMode::Open, title: title, directory: String::new(), name: String::new(), filters: filters, backend: FileBackend::Auto, purpose: String::new(), needs_favorites: false }
}

/// Choose where to save.
pub fn save_file(id: String, title: String, name: String, filters: Vec<FileFilter>) -> DialogRequest {
    DialogRequest::File { id: id, mode: FileMode::Save, title: title, directory: String::new(), name: name, filters: filters, backend: FileBackend::Auto, purpose: String::new(), needs_favorites: false }
}

/// Choose a folder.
pub fn select_folder(id: String, title: String) -> DialogRequest {
    DialogRequest::File { id: id, mode: FileMode::Folder, title: title, directory: String::new(), name: String::new(), filters: #[], backend: FileBackend::Auto, purpose: String::new(), needs_favorites: false }
}

pub fn about(id: String, name: String, version: String, description: String) -> DialogRequest {
    DialogRequest::About { id: id, name: name, version: version, description: description, credits: String::new(), licenses: String::new(), diagnostics: String::new(), links: #[] }
}

impl Display for DialogRequest {
    fn fmt(&self) -> String {
        f"DialogRequest({self.id()})"
    }
}

impl Debug for DialogRequest {
    fn fmt(&self) -> String {
        f"DialogRequest {{ id: {self.id():?}, title: {self.title():?} }}"
    }
}

/// Uses the toolkit file browser, including its persistent locations sidebar.
pub fn toolkit_file(req: DialogRequest) -> DialogRequest {
    match req {
        DialogRequest::File { id, mode, title, directory, name, filters, purpose, .. } => DialogRequest::File {
            id: id, mode: mode, title: title, directory: directory, name: name
            filters: filters, backend: FileBackend::Toolkit, purpose: purpose, needs_favorites: true
        }
        _ => req
    }
}

/// A family/style/size picker with reversible live preview.
pub fn font(id: String, title: String, initial: String) -> DialogRequest { DialogRequest::Font { id: id, title: title, initial: initial } }
pub fn date(id: String, title: String, initial: String, mode: DateMode, min: String, max: String) -> DialogRequest { DialogRequest::Date { id: id, title: title, initial: initial, mode: mode, min: min, max: max } }
pub fn preferences(id: String, title: String, pages: Vec<PreferencePage>) -> DialogRequest { DialogRequest::Preferences { id: id, title: title, pages: pages, checked: false } }
/// A form of `fields` whose accept button reads `accept`.
pub fn form(id: String, title: String, fields: Vec<PreferenceField>, accept: String) -> DialogRequest { DialogRequest::Form { id: id, title: title, fields: fields, accept: accept } }
pub fn wizard(id: String, title: String, pages: Vec<WizardPage>) -> DialogRequest { DialogRequest::Wizard { id: id, title: title, pages: pages, checked: false } }

/// `req` (preferences or a wizard) asking the application before a step
/// takes effect: Apply, OK, Next or Finish sends `UiMsg::DialogCheck(id,
/// request, step, values)` and waits, showing it is working, until
/// `Effect::DialogChecked(id, request, error)` answers. "" lets the step
/// proceed; an error is shown and the drafts stay for another try. Stop (or
/// Cancel) abandons the wait, reported as `UiMsg::DialogCheckStopped`.
pub fn checked(req: DialogRequest) -> DialogRequest {
    match req {
        DialogRequest::Preferences { id, title, pages, .. } => DialogRequest::Preferences { id: id, title: title, pages: pages, checked: true }
        DialogRequest::Wizard { id, title, pages, .. } => DialogRequest::Wizard { id: id, title: title, pages: pages, checked: true }
        _ => req
    }
}
