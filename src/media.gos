// Media players: audio and video played by GStreamer 1.x, which loads at
// run time and is optional; without it a player reports `Unavailable`.
// The video surface draws the newest frame; `controls` builds play, seek,
// time, volume and mute from ordinary accessible widgets, and `handle`
// folds their messages back into the player. State changes and progress
// arrive as `UiMsg::Media(player, status)`.

use std::errors
use std::encoding::json

use crate::{UiMsg, Widget}

/// Where a player's sound goes.
#[derive(PartialEq, Eq)]
pub enum AudioOutput {
    System
    /// Nowhere, keeping playback's timing.
    Discard
}

/// What a player is doing.
#[derive(PartialEq)]
pub enum State {
    Unavailable(String)
    Idle
    Loading
    Paused
    Playing
    Ended
    Failed(String)
}

/// A player's state.
#[derive(PartialEq)]
pub struct Status {
    pub state: State
    pub source: String
    pub position_ms: i64
    /// -1 while unknown.
    pub duration_ms: i64
    pub volume: f64
    pub muted: bool
    pub width: i64
    pub height: i64
    pub frames: i64
}

/// The video surface of player `player`.
pub struct View {
    pub id: String
    pub player: i64
    pub label: String
    pub width: i64
    pub height: i64
}

enum Answer {
    Id(i64)
    Status(Status)
    Done
}

/// A media player handle; it closes with its session.
#[derive(Default, PartialEq, Eq)]
pub struct Player {
    pub id: i64
}

fn call(method: String, id: i64, args: String) -> Result<Answer, errors::Error> {
    let answer = gui_engine::media(method, id, args).map_err(|why| errors::new(why))?
    json::decode::<Answer>(answer)
}

fn done(answer: Result<Answer, errors::Error>) -> Result<(), errors::Error> {
    answer.map(|_| ())
}

/// A time as minutes and seconds.
pub fn clock(ms: i64) -> String {
    if ms < 0 {
        return "--:--"
    }
    let s = ms / 1000
    f"{s / 60}:{s % 60:02}"
}

impl Player {
    pub fn open(output: AudioOutput = AudioOutput::System) -> Result<Player, errors::Error> {
        match call("open", 0, json::encode(output))? {
            Answer::Id(id) => Ok(Player { id: id })
            _ => Err(errors::new("invalid media answer"))
        }
    }

    /// Loads a file path or URI, paused at its start.
    pub fn load(&self, source: String) -> Result<(), errors::Error> {
        done(call("load", self.id, json::encode(source)))
    }

    pub fn play(&self) -> Result<(), errors::Error> {
        done(call("play", self.id, "null"))
    }

    pub fn pause(&self) -> Result<(), errors::Error> {
        done(call("pause", self.id, "null"))
    }

    pub fn seek(&self, position_ms: i64) -> Result<(), errors::Error> {
        done(call("seek", self.id, json::encode(position_ms)))
    }

    /// Sets the volume, 0 to 1.
    pub fn set_volume(&self, volume: f64) -> Result<(), errors::Error> {
        done(call("volume", self.id, json::encode(volume)))
    }

    pub fn set_muted(&self, muted: bool) -> Result<(), errors::Error> {
        done(call("mute", self.id, json::encode(muted)))
    }

    pub fn status(&self) -> Result<Status, errors::Error> {
        match call("status", self.id, "null")? {
            Answer::Status(status) => Ok(status)
            _ => Err(errors::new("invalid media answer"))
        }
    }

    /// The video surface.
    pub fn view(&self, id: String, label: String, width: i64 = 640, height: i64 = 360) -> Widget {
        Widget::Media(View { id: id, player: self.id, label: label, width: width, height: height })
    }

    /// Transport controls named `{prefix}:play`, `{prefix}:seek`,
    /// `{prefix}:volume` and `{prefix}:mute`.
    pub fn controls(&self, prefix: String) -> Widget {
        let status = self.status().unwrap_or(Status { state: State::Idle, source: "", position_ms: 0, duration_ms: -1, volume: 1.0, muted: false, width: 0, height: 0, frames: 0 })
        let playing = status.state == State::Playing
        let length = status.duration_ms.max(1) as f64 / 1000.0
        Widget::row(#[
            Widget::button(f"{prefix}:play", if playing { "Pause" } else { "Play" })
            Widget::slider(f"{prefix}:seek", status.position_ms as f64 / 1000.0, 0.0, length, 0.1).grow(1)
            Widget::label(f"{clock(status.position_ms)} / {clock(status.duration_ms)}")
            Widget::slider(f"{prefix}:volume", status.volume, 0.0, 1.0, 0.05)
            Widget::checkbox(f"{prefix}:mute", "Mute", status.muted)
        ], 8)
    }

    /// Applies a message from `controls(prefix)`, answering whether it was one.
    pub fn handle(&self, prefix: String, msg: UiMsg) -> bool {
        match msg {
            UiMsg::Click(id) if id == f"{prefix}:play" => {
                let playing = self.status().map(|s| s.state == State::Playing).unwrap_or(false)
                let _ = if playing { self.pause() } else { self.play() }
                true
            }
            UiMsg::Value(id, value) if id == f"{prefix}:seek" => {
                let _ = self.seek((value * 1000.0) as i64)
                true
            }
            UiMsg::Value(id, value) if id == f"{prefix}:volume" => {
                let _ = self.set_volume(value)
                true
            }
            UiMsg::Toggle(id, on) if id == f"{prefix}:mute" => {
                let _ = self.set_muted(on)
                true
            }
            _ => false
        }
    }

    pub fn close(&self) {
        let _ = call("close", self.id, "null")
    }
}
