// apps: the applications installed on the machine, for launchers. Linux
// reads freedesktop desktop entries from the XDG data folders, macOS the
// bundles in the Applications folders, Windows the Start menu's shortcuts.
// `Effect::LoadApps` builds the catalog and `Effect::LaunchApp` starts one
// off the UI thread; neither runs a shell.

use std::encoding::json
use gui_engine
use std::{env, errors, fs, path}
use std::process::Command

use crate::services

/// One application a launcher can start.
#[derive(Debug, PartialEq)]
pub struct AppEntry {
    /// Unique within the catalog: the desktop file id, the bundle path, or
    /// the shortcut path.
    pub id: String
    pub name: String
    pub generic_name: String
    pub comment: String
    /// An icon name or file.
    pub icon: String
    pub keywords: Vec<String>
    pub categories: Vec<String>
    /// The program and its arguments, still holding the entry's field codes
    /// (`%f`, `%U`, ...) that `command_for` fills.
    pub exec: Vec<String>
    /// Runs inside a terminal emulator.
    pub terminal: bool
    /// The file the entry came from.
    pub source: String
    /// The icon's pixels when `with_icons` found a PNG or SVG for it.
    pub image: Option<AppIcon>
}

/// An application icon's RGBA pixels.
#[derive(Debug, PartialEq)]
pub struct AppIcon {
    pub rgba: Vec<u8>
    pub width: i64
    pub height: i64
}

impl AppIcon {
    /// A `size` pixel square icon: a rounded tile of `background` with the
    /// built-in `glyph` drawn on it in `foreground`, transparent outside.
    pub fn drawn(glyph: crate::render::icons::Icon, size: i64, background: crate::style::color::Color, foreground: crate::style::color::Color) -> AppIcon {
        let answered = gui_engine::app_icon_drawn(json::encode(glyph), size, json::encode(background), json::encode(foreground))
        match answered.map(|text| json::decode::<AppIcon>(text)) {
            Ok(Ok(icon)) => icon
            Ok(Err(e)) => panic(f"gui: a drawn icon did not decode: {e}")
            Err(e) => panic(f"gui: drawing an icon: {e}")
        }
    }

    /// The icon as a PNG file.
    pub fn to_png(&self) -> Vec<u8> {
        match gui_engine::app_icon_png(json::encode(*self)) {
            Ok(png) => png
            Err(e) => panic(f"gui: encoding an icon: {e}")
        }
    }


}

/// Whether `entry` matches every word of `query` in its name, generic name,
/// comment or keywords (case-insensitive).
pub fn matches_query(entry: AppEntry, query: String) -> bool {
    let mut fields = #[entry.name, entry.generic_name, entry.comment]
    for k in entry.keywords { fields.push(k) }
    let haystack = fields.join(" ").to_lowercase()
    query.to_lowercase().split_whitespace().iter().all(|w| haystack.contains(w))
}

// How `name` matches `q`, both lowercase: 3 when it starts with `q`, 2 when
// one of its words does, 1 when it contains `q`, else 0.
fn name_match(name: String, q: String) -> i64 {
    if name.starts_with(q) { return 3 }
    if name.split_whitespace().iter().any(|w| w.starts_with(q)) { return 2 }
    if name.contains(q) { 1 } else { 0 }
}

/// The entries matching `query` (see `matches_query`), best first, at most
/// `limit`: a name starting with the query, then one with a word starting
/// with it, then one containing it, then a match elsewhere; a recent launch
/// ranks above a match of the same kind and newer above older, then names
/// sort alphabetically.
pub fn search(entries: Vec<AppEntry>, query: String, history: AppHistory, limit: i64) -> Vec<AppEntry> {
    let q = query.trim().to_lowercase()
    if q.is_empty() { return #[] }
    let mut found = #[]
    for e in entries {
        if !matches_query(e, q) { continue }
        let name = e.name.to_lowercase()
        let kind = name_match(name, q)
        let recency = match history.recent.iter().position(|r| r == e.id) {
            Some(i) => RECENT_LIMIT - i
            None => 0
        }
        found.push((kind * (RECENT_LIMIT + 1) + recency, name, e))
    }
    found.sort_by_key(|f| (Reverse(f.0), f.1))
    let ranked = found.map(|f| f.2)
    if ranked.len() > limit { ranked[0..limit] } else { ranked }
}

// ---- desktop entries (freedesktop.org Desktop Entry Specification) ----

// A value with the specification's escapes (`\s`, `\n`, `\t`, `\r`, `\\`) undone.
fn unescape(value: String) -> String {
    let mut out = String::new()
    let mut escaped = false
    for c in value {
        if escaped {
            match c {
                's' => out.push(' ')
                'n' => out.push('\n')
                't' => out.push('\t')
                'r' => out.push('\r')
                _ => out.push(c)
            }
            escaped = false
        } else if c == '\\' {
            escaped = true
        } else {
            out.push(c)
        }
    }
    out
}

// A `;`-separated list value; a trailing `;` ends the last item.
fn list_value(value: String) -> Vec<String> {
    unescape(value).split(";").filter(|s| !s.is_empty())
}

// The `Exec` value split into arguments: double quotes group, and inside
// them `\"`, `` \` ``, `\$` and `\\` stand for the character.
fn exec_arguments(value: String) -> Vec<String> {
    let mut out = #[]
    let mut current = String::new()
    let mut started = false
    let mut quoted = false
    let mut escaped = false
    for c in unescape(value) {
        if quoted {
            if escaped { current.push(c); escaped = false }
            else if c == '\\' { escaped = true }
            else if c == '"' { quoted = false }
            else { current.push(c) }
        } else if c == '"' {
            quoted = true
            started = true
        } else if c == ' ' || c == '\t' {
            if started { out.push(current); current = String::new(); started = false }
        } else {
            current.push(c)
            started = true
        }
    }
    if started { out.push(current) }
    out
}

// The value of `key` for the most specific of `locale`'s forms
// (`ll_CC@MOD`, `ll_CC`, `ll@MOD`, `ll`), else the plain value.
fn localized(values: Map<String, String>, key: String, locale: String) -> String {
    let tag = locale.split(".")[0]
    let lang_country, modifier = match tag.split_once("@") {
        Some((a, b)) => (a, b)
        None => (tag, String::new())
    }
    let lang = lang_country.split("_")[0]
    let mut forms = #[]
    if !modifier.is_empty() { forms.push(f"{lang_country}@{modifier}") }
    forms.push(lang_country)
    if !modifier.is_empty() { forms.push(f"{lang}@{modifier}") }
    forms.push(lang)
    for form in forms {
        if let Some(v) = values.get(f"{key}[{form}]") { return unescape(v) }
    }
    unescape(values.get(key).unwrap_or(""))
}

/// The application a desktop entry describes, or `None` when it is not one
/// to show: not `Type=Application`, `NoDisplay` or `Hidden`, shown only in
/// other desktops (`OnlyShowIn` / `NotShowIn` against `desktops`), or
/// without an `Exec`. `locale` picks localized names (`de_DE`).
pub fn parse_desktop_entry(text: String, id: String, source: String, locale: String, desktops: Vec<String>) -> Option<AppEntry> {
    let values = ini_groups(text).get("Desktop Entry").unwrap_or(Map::new())
    if values.get("Type").unwrap_or("") != "Application" { return None }
    if values.get("NoDisplay").unwrap_or("") == "true" || values.get("Hidden").unwrap_or("") == "true" { return None }
    let only = list_value(values.get("OnlyShowIn").unwrap_or(""))
    if !only.is_empty() && !only.iter().any(|d| desktops.contains(d)) { return None }
    let not = list_value(values.get("NotShowIn").unwrap_or(""))
    if not.iter().any(|d| desktops.contains(d)) { return None }
    let exec = exec_arguments(values.get("Exec").unwrap_or(""))
    if exec.is_empty() { return None }
    let name = localized(values, "Name", locale)
    if name.is_empty() { return None }
    Some(AppEntry {
        id: id
        name: name
        generic_name: localized(values, "GenericName", locale)
        comment: localized(values, "Comment", locale)
        icon: localized(values, "Icon", locale)
        keywords: list_value(localized(values, "Keywords", locale))
        categories: list_value(values.get("Categories").unwrap_or(""))
        exec: exec
        terminal: values.get("Terminal").unwrap_or("") == "true"
        source: source
        image: None
    })
}

/// The arguments that start `entry` on `files` (paths): `%f`/`%u` take the
/// first file and `%F`/`%U` all of them, `%i` the icon (`--icon NAME`), `%c`
/// the name, `%k` the entry's file, `%%` a percent sign; deprecated codes
/// are dropped.
pub fn command_for(entry: AppEntry, files: Vec<String>) -> Vec<String> {
    let mut out = #[]
    for arg in entry.exec {
        match arg {
            "%f" | "%u" => if !files.is_empty() { out.push(files[0]) }
            "%F" | "%U" => for f in files { out.push(f) }
            "%i" => if !entry.icon.is_empty() { out.push("--icon"); out.push(entry.icon) }
            "%c" => out.push(entry.name)
            "%k" => out.push(entry.source)
            "%d" | "%D" | "%n" | "%N" | "%v" | "%m" => ()
            _ => {
                let mut text = String::new()
                let mut percent = false
                for c in arg {
                    if percent {
                        match c {
                            '%' => text.push('%')
                            'c' => text += entry.name
                            'k' => text += entry.source
                            _ => ()
                        }
                        percent = false
                    } else if c == '%' {
                        percent = true
                    } else {
                        text.push(c)
                    }
                }
                out.push(text)
            }
        }
    }
    out
}

// Whether `program` can run: an existing absolute path, or a name found on PATH.
fn on_path(program: String) -> bool {
    if path::is_absolute(program) { return fs::is_file(program) }
    env::var("PATH").unwrap_or("").split(":").iter().any(|dir| !dir.is_empty() && fs::is_file(path::join(dir, program)))
}

/// The XDG data folders' `applications` folders, most important first.
pub fn desktop_entry_dirs() -> Vec<String> {
    let home = env::home_dir().unwrap_or("")
    let data_home = env::var("XDG_DATA_HOME").unwrap_or(path::join(home, ".local/share"))
    let mut out = #[path::join(data_home, "applications")]
    for d in env::var("XDG_DATA_DIRS").unwrap_or("/usr/local/share:/usr/share").split(":") {
        if !d.is_empty() { out.push(path::join(d, "applications")) }
    }
    out
}

// Every `.desktop` file under `root`, with its desktop file id (its path
// below `root`, `/` read as `-`).
fn desktop_files(root: String) -> Vec<(String, String)> {
    let mut out = #[]
    let mut pending = #[root]
    while let Some(dir) = pending.pop() {
        let Ok(entries) = fs::read_dir(dir) else { continue }
        for e in entries {
            if e.is_dir { pending.push(e.path); continue }
            if !e.name.ends_with(".desktop") { continue }
            let relative = e.path.substring(root.byte_len() + 1, e.path.byte_len())
            out.push((relative.replace("/", "-"), e.path))
        }
    }
    out
}

/// The desktop entries in `dirs` (most important first): an id seen in an
/// earlier folder hides later ones, and entries whose `TryExec` cannot run
/// are left out. Sorted by name.
pub fn scan_desktop_entries(dirs: Vec<String>, locale: String, desktops: Vec<String>) -> Vec<AppEntry> {
    let mut seen = #{}
    let mut out = #[]
    for dir in dirs {
        for (id, file) in desktop_files(dir) {
            if seen.contains(id) { continue }
            seen.insert(id)
            let Ok(text) = fs::read_to_string(file) else { continue }
            let try_exec = text.lines().iter().find(|l| l.starts_with("TryExec=")).map(|l| l.substring(8, l.byte_len()).trim()).unwrap_or("")
            if !try_exec.is_empty() && !on_path(try_exec) { continue }
            if let Some(entry) = parse_desktop_entry(text, id, file, locale, desktops) { out.push(entry) }
        }
    }
    out.sort_by(|a, b| if a.name.to_lowercase() < b.name.to_lowercase() { -1 } else if a.name.to_lowercase() > b.name.to_lowercase() { 1 } else { 0 })
    out
}

// ---- macOS bundles ----

/// The string values of an XML property list's top-level dictionary, by key.
/// Binary property lists answer an empty map.
pub fn plist_strings(xml: String) -> Map<String, String> {
    let mut out = Map::new()
    let mut rest = xml
    while let Some(at) = rest.find("<key>") {
        let after = rest.substring(at + 5, rest.byte_len())
        let Some(end) = after.find("</key>") else { break }
        let key = after.substring(0, end)
        let tail = after.substring(end + 6, after.byte_len()).trim_start()
        if tail.starts_with("<string>") {
            let body = tail.substring(8, tail.byte_len())
            if let Some(close) = body.find("</string>") {
                out[key] = body.substring(0, close).replace("&lt;", "<").replace("&gt;", ">").replace("&quot;", "\"").replace("&apos;", "'").replace("&amp;", "&")
            }
        }
        rest = tail
    }
    out
}

/// The application in the bundle at `bundle` (`Name.app`), named from its
/// `Info.plist` when that is XML, else from the folder; it starts with
/// `open -a`, which also handles bundles whose list is binary.
pub fn bundle_entry(bundle: String, info: String) -> AppEntry {
    let keys = plist_strings(info)
    let folder = path::file_name(bundle).unwrap_or(bundle)
    let fallback = if folder.ends_with(".app") { folder.substring(0, folder.byte_len() - 4) } else { folder }
    let name = keys.get("CFBundleDisplayName").unwrap_or(keys.get("CFBundleName").unwrap_or(fallback))
    AppEntry { id: bundle, name: name, generic_name: String::new(), comment: String::new(), icon: keys.get("CFBundleIconFile").unwrap_or(""), keywords: #[], categories: #[], exec: #["/usr/bin/open", "-a", bundle, "%F"], terminal: false, source: path::join(bundle, "Contents/Info.plist"), image: None }
}

fn scan_bundles(dirs: Vec<String>) -> Vec<AppEntry> {
    let mut out = #[]
    for dir in dirs {
        let Ok(entries) = fs::read_dir(dir) else { continue }
        for e in entries {
            if !e.is_dir || !e.name.ends_with(".app") { continue }
            let info = fs::read_to_string(path::join(e.path, "Contents/Info.plist")).unwrap_or("")
            out.push(bundle_entry(e.path, info))
        }
    }
    out.sort_by(|a, b| if a.name.to_lowercase() < b.name.to_lowercase() { -1 } else if a.name.to_lowercase() > b.name.to_lowercase() { 1 } else { 0 })
    out
}

// ---- Windows shortcuts (MS-SHLLINK) ----

fn le32(b: Vec<u8>, at: i64) -> i64 {
    if at < 0 || at + 4 > b.len() { return -1 }
    (b[at] as i64) | ((b[at + 1] as i64) << 8) | ((b[at + 2] as i64) << 16) | ((b[at + 3] as i64) << 24)
}

fn le16(b: Vec<u8>, at: i64) -> i64 {
    if at < 0 || at + 2 > b.len() { return -1 }
    (b[at] as i64) | ((b[at + 1] as i64) << 8)
}

/// The local path a shell link (`.lnk`) points at, from its LinkInfo's
/// local base path; `None` for links without one (network or item-list only).
pub fn shell_link_target(b: Vec<u8>) -> Option<String> {
    if le32(b, 0) != 0x4C { return None }
    let flags = le32(b, 20)
    let mut at = 0x4C
    // HasLinkTargetIDList: a size-prefixed item list comes first.
    if flags & 1 != 0 { at += 2 + le16(b, at) }
    // HasLinkInfo.
    if flags & 2 == 0 { return None }
    let info = at
    let info_size = le32(b, info)
    let info_flags = le32(b, info + 8)
    if info_size <= 0 || info_flags & 1 == 0 { return None }
    let base = info + le32(b, info + 16)
    let mut out = String::new()
    let mut i = base
    while i < b.len() && i < info + info_size && b[i] != 0u8 {
        out.push(char::from_u32(b[i] as u32).unwrap_or('?'))
        i += 1
    }
    if out.is_empty() { None } else { Some(out) }
}

fn scan_shortcuts(dirs: Vec<String>) -> Vec<AppEntry> {
    let mut out = #[]
    let mut pending = dirs
    while let Some(dir) = pending.pop() {
        let Ok(entries) = fs::read_dir(dir) else { continue }
        for e in entries {
            if e.is_dir { pending.push(e.path); continue }
            if !e.name.to_lowercase().ends_with(".lnk") { continue }
            let Ok(bytes) = fs::read(e.path) else { continue }
            let Some(target) = shell_link_target(bytes) else { continue }
            if !target.to_lowercase().ends_with(".exe") { continue }
            let name = e.name.substring(0, e.name.byte_len() - 4)
            out.push(AppEntry { id: e.path, name: name, generic_name: String::new(), comment: String::new(), icon: target, keywords: #[], categories: #[], exec: #[target, "%F"], terminal: false, source: e.path, image: None })
        }
    }
    out.sort_by(|a, b| if a.name.to_lowercase() < b.name.to_lowercase() { -1 } else if a.name.to_lowercase() > b.name.to_lowercase() { 1 } else { 0 })
    out
}

// ---- icons ----

// The groups of an ini-style file, each `[name]` mapped to its `key=value`
// lines, later keys winning.
fn ini_groups(text: String) -> Map<String, Map<String, String>> {
    let mut groups: Map<String, Map<String, String>> = Map::new()
    let mut current = String::new()
    for raw in text.lines() {
        let line = raw.trim()
        if line.is_empty() || line.starts_with("#") { continue }
        if line.starts_with("[") && line.ends_with("]") {
            current = line.substring(1, line.byte_len() - 1)
            continue
        }
        let Some((key, value)) = line.split_once("=") else { continue }
        let mut group = groups.get(current).unwrap_or(Map::new())
        group[key.trim()] = value.trim()
        groups[current] = group
    }
    groups
}

#[derive(PartialEq)]
enum IconDirKind {
    Fixed
    Scalable
    Threshold
}

// One folder of the icon theme, the pixel sizes it serves, and its files.
struct IconDir {
    folder: String
    kind: IconDirKind
    size: i64
    min: i64
    max: i64
    threshold: i64
    files: Set<String>
}

impl IconDir {
    // How far this folder's sizes are from `px` pixels; 0 when it serves them
    // (the Icon Theme Specification's DirectorySizeDistance).
    fn distance(&self, px: i64) -> i64 {
        let lo, hi = match self.kind {
            IconDirKind::Fixed => (self.size, self.size)
            IconDirKind::Scalable => (self.min, self.max)
            IconDirKind::Threshold => (self.size - self.threshold, self.size + self.threshold)
        }
        if px < lo { lo - px } else if px > hi { px - hi } else { 0 }
    }
}

// The formats `load_icon_file` reads, in the order a folder prefers them.
const ICON_EXTENSIONS: [String; 2] = ["png", "svg"]

/// Icons by name from the `hicolor` theme every XDG desktop installs, then
/// `pixmaps`; each folder is listed once, so a lookup reads no files.
pub struct IconLookup {
    dirs: Vec<IconDir>
}

impl IconLookup {
    /// The `hicolor` folders under the XDG data folders, the user's first.
    pub fn new() -> IconLookup {
        let home = env::home_dir().unwrap_or("")
        let mut roots = #[path::join(env::var("XDG_DATA_HOME").unwrap_or(path::join(home, ".local/share")), "icons")]
        for d in env::var("XDG_DATA_DIRS").unwrap_or("/usr/local/share:/usr/share").split(":") {
            if !d.is_empty() { roots.push(path::join(d, "icons")) }
        }
        IconLookup::in_roots(roots)
    }

    /// The `hicolor` folders under each of `roots`, the first most important.
    pub fn in_roots(roots: Vec<String>) -> IconLookup {
        let homes = roots.map(|r| path::join(r, "hicolor")).filter(|d| fs::is_dir(d))
        let mut dirs = #[]
        let Some(index) = homes.iter().map(|d| path::join(d, "index.theme")).find(|f| fs::is_file(f)) else { return IconLookup { dirs: dirs } }
        let Ok(text) = fs::read_to_string(index) else { return IconLookup { dirs: dirs } }
        let groups = ini_groups(text)
        let head = groups.get("Icon Theme").unwrap_or(Map::new())
        for sub in head.get("Directories").unwrap_or("").split(",") {
            let Some(g) = groups.get(sub.trim()) else { continue }
            let num = |k: String, d: i64| g.get(k).and_then(|v| v.to_i64()).unwrap_or(d)
            // Folders for other scales serve their pixel size: 24 at @2 is 48.
            let scale = num("Scale", 1).max(1)
            let size = num("Size", 0) * scale
            if size <= 0 { continue }
            let kind = match g.get("Type").unwrap_or("Threshold") {
                "Fixed" => IconDirKind::Fixed
                "Scalable" => IconDirKind::Scalable
                _ => IconDirKind::Threshold
            }
            for home in homes {
                let folder = path::join(home, sub.trim())
                let Ok(entries) = fs::read_dir(folder) else { continue }
                let mut files = Set::new()
                for e in entries { files.insert(e.name) }
                dirs.push(IconDir { folder: folder, kind: kind, size: size, min: num("MinSize", size / scale) * scale, max: num("MaxSize", size / scale) * scale, threshold: num("Threshold", 2) * scale, files: files })
            }
        }
        IconLookup { dirs: dirs }
    }

    /// The file for icon `name` nearest `px` pixels: `name` itself when it is
    /// a path, else the theme folder serving that size (PNG before SVG) or
    /// the nearest one, else `pixmaps`.
    pub fn find(&self, name: String, px: i64) -> Option<String> {
        if name.is_empty() { return None }
        if path::is_absolute(name) { return if readable_icon(name) && fs::is_file(name) { Some(name) } else { None } }
        let lower = name.to_lowercase()
        // Desktop entries sometimes name the file; the theme holds the stem.
        let stem = if lower.ends_with(".png") || lower.ends_with(".svg") { name.substring(0, name.byte_len() - 4) } else { name }
        let mut best = None
        let mut best_distance = i64::MAX
        for d in self.dirs {
            for ext in ICON_EXTENSIONS {
                let file = f"{stem}.{ext}"
                if !d.files.contains(file) { continue }
                let distance = d.distance(px)
                if distance == 0 { return Some(path::join(d.folder, file)) }
                if distance < best_distance {
                    best = Some(path::join(d.folder, file))
                    best_distance = distance
                }
            }
        }
        if best.is_some() { return best }
        for ext in ICON_EXTENSIONS {
            let file = path::join("/usr/share/pixmaps", f"{stem}.{ext}")
            if fs::is_file(file) { return Some(file) }
        }
        None
    }
}

fn readable_icon(file: String) -> bool {
    let lower = file.to_lowercase()
    lower.ends_with(".png") || lower.ends_with(".svg")
}

/// The file for icon `name` nearest `size` pixels (see `IconLookup::find`).
pub fn icon_file(name: String, size: i64) -> Option<String> {
    IconLookup::new().find(name, size)
}

// `rgba` (w x h) shrunk to fit `size` x `size` by averaging the pixels each
// target pixel covers.
fn shrink(rgba: Vec<u8>, w: i64, h: i64, size: i64) -> AppIcon {
    if w <= size && h <= size { return AppIcon { rgba: rgba, width: w, height: h } }
    let scale = (w.max(h) as f64) / size as f64
    let tw = ((w as f64 / scale) as i64).max(1)
    let th = ((h as f64 / scale) as i64).max(1)
    let mut out = #[0u8; tw * th * 4]
    let mut y = 0
    while y < th {
        let y0 = (y as f64 * scale) as i64
        let y1 = (((y + 1) as f64 * scale) as i64).min(h).max(y0 + 1)
        let mut x = 0
        while x < tw {
            let x0 = (x as f64 * scale) as i64
            let x1 = (((x + 1) as f64 * scale) as i64).min(w).max(x0 + 1)
            let mut sums = [0, 0, 0, 0]
            let mut sy = y0
            while sy < y1 {
                let mut sx = x0
                while sx < x1 {
                    let at = (sy * w + sx) * 4
                    // Colors weigh by their coverage so transparent edges do not darken.
                    let a = rgba[at + 3] as i64
                    sums[0] += rgba[at] as i64 * a
                    sums[1] += rgba[at + 1] as i64 * a
                    sums[2] += rgba[at + 2] as i64 * a
                    sums[3] += a
                    sx += 1
                }
                sy += 1
            }
            let count = (y1 - y0) * (x1 - x0)
            let o = (y * tw + x) * 4
            if sums[3] > 0 {
                out[o] = (sums[0] / sums[3]) as u8
                out[o + 1] = (sums[1] / sums[3]) as u8
                out[o + 2] = (sums[2] / sums[3]) as u8
            }
            out[o + 3] = (sums[3] / count) as u8
            x += 1
        }
        y += 1
    }
    AppIcon { rgba: out, width: tw, height: th }
}

/// A pixel size for `with_icons`: room for a 64-unit icon at scale 1.5.
pub const ICON_SIZE: i64 = 96


struct IconCatalog { entries: Vec<AppEntry> }

/// Loads available desktop icons once; call off the UI thread for large catalogs.
pub fn with_icons(entries: Vec<AppEntry>, size: i64) -> Vec<AppEntry> {
    match gui_engine::apps_with_icons(json::encode(entries), size) {
        Ok(text) => json::decode::<IconCatalog>(f"{{\"entries\":{text}}}").map(|catalog| catalog.entries).unwrap_or(entries)
        Err(_) => entries
    }
}

// ---- the platform catalog ----

/// The applications installed for this user, by name.
#[cfg(target_os = "linux")]
pub fn installed() -> Vec<AppEntry> {
    let locale = env::var("LC_ALL").unwrap_or(env::var("LC_MESSAGES").unwrap_or(env::var("LANG").unwrap_or("")))
    let desktops = env::var("XDG_CURRENT_DESKTOP").unwrap_or("").split(":").filter(|d| !d.is_empty())
    scan_desktop_entries(desktop_entry_dirs(), locale, desktops)
}

/// The applications installed for this user, by name.
#[cfg(target_os = "macos")]
pub fn installed() -> Vec<AppEntry> {
    scan_bundles(#["/Applications", "/System/Applications", path::join(env::home_dir().unwrap_or(""), "Applications")])
}

/// The applications installed for this user, by name.
#[cfg(target_os = "windows")]
pub fn installed() -> Vec<AppEntry> {
    let mut dirs = #[]
    if let Some(d) = env::var("APPDATA") { dirs.push(path::join(d, "Microsoft\\Windows\\Start Menu\\Programs")) }
    if let Some(d) = env::var("ProgramData") { dirs.push(path::join(d, "Microsoft\\Windows\\Start Menu\\Programs")) }
    scan_shortcuts(dirs)
}

/// Starts `entry` on `files` as its own process, never through a shell; an
/// entry that wants a terminal runs in `$TERMINAL` (or `x-terminal-emulator`).
pub fn launch(entry: AppEntry, files: Vec<String>) -> Result<(), errors::Error> {
    let mut argv = command_for(entry, files)
    if argv.is_empty() { return Err(errors::new(f"{entry.name} has no command")) }
    if entry.terminal {
        let terminal = env::var("TERMINAL").unwrap_or("x-terminal-emulator")
        let mut wrapped = #[terminal, "-e"]
        for a in argv { wrapped.push(a) }
        argv = wrapped
    }
    let mut cmd = Command::new(argv[0])
    let mut i = 1
    while i < argv.len() {
        cmd = cmd.arg(argv[i])
        i += 1
    }
    let _ = cmd.spawn()?
    Ok(())
}

// ---- favorites and recent launches ----

/// The applications a user pinned and the ones they started last, by id.
#[derive(Debug, Default, PartialEq)]
pub struct AppHistory {
    pub favorites: Vec<String>
    /// Newest first.
    pub recent: Vec<String>
}

/// The most recent launches `AppHistory` keeps.
pub const RECENT_LIMIT: i64 = 20

impl AppHistory {
    /// This history with `id` started now: first in `recent`, once.
    pub fn launched(&self, id: String) -> AppHistory {
        let mut recent = #[id]
        for r in self.recent { if r != id && recent.len() < RECENT_LIMIT { recent.push(r) } }
        AppHistory { favorites: self.favorites, recent: recent }
    }

    /// This history with `id` pinned or unpinned.
    pub fn toggled_favorite(&self, id: String) -> AppHistory {
        let mut favorites = self.favorites.filter(|f| f != id)
        if favorites.len() == self.favorites.len() { favorites.push(id) }
        AppHistory { favorites: favorites, recent: self.recent }
    }
}

fn history_file(app_id: String) -> String { services::settings_path(app_id, "launcher-history") }

/// The launcher history saved for `app_id`; empty when none was saved.
pub fn load_history(app_id: String) -> Result<AppHistory, errors::Error> {
    let s = services::load_settings(history_file(app_id), 1, |_, s| s)?
    Ok(AppHistory { favorites: s.get_list("favorites"), recent: s.get_list("recent") })
}

/// Saves `history` for `app_id`.
pub fn save_history(app_id: String, history: AppHistory) -> Result<(), errors::Error> {
    let mut s = services::Settings { version: 1, values: Map::new() }
    s.set_list("favorites", history.favorites)
    s.set_list("recent", history.recent)
    services::save_settings(history_file(app_id), s)
}
