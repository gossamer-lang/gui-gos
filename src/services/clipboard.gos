// clipboard: text, primary selection, and MIME data, through the toolkit's
// clipboard: the platform's, or an in-memory board for tests and headless
// runs. The toolkit's own copies (a terminal's, a program's OSC 52 write)
// use the same one, so one switch makes a whole session deterministic.

use gui_engine

/// Routes clipboard calls to an in-memory board (`true`) or the system.
pub fn use_memory(memory: bool) {
    gui_engine::clipboard_use_memory(memory)
}

pub fn is_memory() -> bool {
    gui_engine::clipboard_is_memory()
}

/// The clipboard's text, or "" when it holds none or cannot be read.
pub fn text() -> String {
    gui_engine::clipboard_text()
}

/// Replaces the clipboard's contents with `text`. A system failure leaves
/// the clipboard unchanged and is not fatal to editing.
pub fn set_text(text: String) {
    gui_engine::clipboard_set_text(text)
}

pub fn has_text() -> bool {
    gui_engine::clipboard_has_text()
}

/// The X11/Wayland primary selection (middle-click paste), where supported.
pub fn primary_text() -> String {
    gui_engine::clipboard_primary_text()
}

/// Replaces the primary selection, where the platform has one.
pub fn set_primary_text(text: String) {
    gui_engine::clipboard_set_primary_text(text)
}

/// Offers several representations at once (e.g. text/plain and text/html).
pub fn set_data(items: Vec<(String, Vec<u8>)>) {
    gui_engine::clipboard_set_data(items.map(|i| i.0), items.map(|i| i.1))
}

/// The clipboard data offered as `mime`, if any.
pub fn data(mime: String) -> Option<Vec<u8>> {
    gui_engine::clipboard_data(mime)
}
