use std::{errors, fs}
use std::encoding::json
use crate::style::color::Color

#[derive(PartialEq)]
pub struct Swatch { pub id: String, pub name: String, pub css: String }
#[derive(PartialEq)]
pub struct ColorPalette { pub version: i64, pub next: i64, pub favorites: Vec<Swatch>, pub recent: Vec<String> }
impl ColorPalette {
    pub fn new() -> ColorPalette { ColorPalette { version: 1, next: 1, favorites: #[], recent: #[] } }
    pub fn decode(text: String) -> Result<ColorPalette, errors::Error> {
        let palette = json::decode::<ColorPalette>(text)?
        if palette.version != 1 || palette.favorites.len() > 128 || palette.recent.len() > 16 { return Err(errors::new("Unsupported or oversized color palette")) }
        let mut ids = #{}
        for s in palette.favorites { if s.id.is_empty() || ids.contains(s.id) || Color::parse_css(s.css).is_none() { return Err(errors::new("Invalid named swatch")) }; ids.insert(s.id) }
        for css in palette.recent { if Color::parse_css(css).is_none() { return Err(errors::new("Invalid recent swatch")) } }
        Ok(palette)
    }
    pub fn load(file: String) -> Result<ColorPalette, errors::Error> {
        if !fs::exists(file) { return Ok(ColorPalette::new()) }
        ColorPalette::decode(fs::read_to_string(file)?)
    }
    pub fn save(&self, file: String) -> Result<(), errors::Error> { crate::services::write_atomic(file, json::encode(*self).bytes()) }
    pub fn remember(&mut self, color: Color) { let css = color.css(); let mut next = #[css]; for item in self.recent { if item != css && next.len() < 16 { next.push(item) } }; self.recent = next }
    /// Saves `color` as a favorite named `name` and answers its id; a color
    /// already saved keeps its place and takes the new name.
    pub fn add(&mut self, name: String, color: Color) -> Result<String, errors::Error> {
        if name.trim().is_empty() { return Err(errors::new("Name the favorite color")) }
        let css = color.css()
        for i in 0..self.favorites.len() {
            if self.favorites[i].css == css { self.favorites[i].name = name.trim(); return Ok(self.favorites[i].id) }
        }
        if self.favorites.len() >= 128 { return Err(errors::new("The favorite colors limit is 128")) }
        let mut id = f"color-{self.next}"
        while self.favorites.iter().any(|s| s.id == id) { self.next += 1; id = f"color-{self.next}" }
        self.next += 1
        self.favorites.push(Swatch { id: id, name: name.trim(), css: css })
        Ok(id)
    }
    pub fn rename(&mut self, id: String, name: String) -> bool {
        if name.trim().is_empty() { return false }
        for i in 0..self.favorites.len() { if self.favorites[i].id == id { self.favorites[i].name = name.trim(); return true } }
        false
    }
    pub fn remove(&mut self, id: String) { self.favorites = self.favorites.filter(|s| s.id != id) }
}
