// Terminals: a screen with bounded scrollback, an optional program on a
// native pseudo-terminal, and the widget that shows and drives one. A
// terminal belongs to the session that opened it and closes with it.

use std::{errors, unicode}
use std::encoding::json

use crate::editing::search::{SearchOptions, Searcher}

// The most matches one search reports.
const MATCH_LIMIT: i64 = 100_000

// What a reset feeds the screen, in order. Leaving the alternate screen brings
// back the program's main screen and cursor. The margins reset between saving
// and restoring the cursor, since resetting them homes it; colors and
// character sets reset after the restore, which brings back the saved ones.
const SOFT_RESET: [String; 10] = [
    "\u{1b}[?1049l"
    "\u{1b}7\u{1b}[?6l\u{1b}[r\u{1b}8"
    "\u{1b}[0m"
    "\u{1b}(B\u{1b})B\u{f}"
    "\u{1b}[4l\u{1b}[?7h\u{1b}[?25h\u{1b}[0 q"
    "\u{1b}[?1l\u{1b}>"
    "\u{1b}[?9l\u{1b}[?1000l\u{1b}[?1002l\u{1b}[?1003l\u{1b}[?1005l\u{1b}[?1006l\u{1b}[?1015l"
    "\u{1b}[?1004l\u{1b}[?2004l"
    "\u{1b}[=0;1u"
    "\u{1b}[?2026l"
]

/// A terminal's screen size and storage limits.
pub struct Options {
    pub rows: i64
    pub cols: i64
    /// Rows of history kept above the screen.
    pub scrollback: i64
    /// The most bytes the screen and its history may hold. The default holds
    /// the largest screen (256 x 512) with the default history, so the screen
    /// always follows its view; the session is charged only for the size in
    /// use.
    pub byte_limit: i64
}

impl Default for Options {
    fn default() -> Options {
        Options { rows: 24, cols: 80, scrollback: 2_000, byte_limit: 67_108_864 }
    }
}

/// A program to run, executed directly rather than through a shell.
#[derive(Default)]
pub struct Command {
    pub program: String
    pub args: Vec<String>
    /// The working directory; empty keeps the application's.
    pub cwd: String
    /// Variables set for the program on top of the inherited environment.
    pub env: Vec<(String, String)>
}

/// A cell position: a row of the visible screen and a column.
#[derive(Default, PartialEq, Eq)]
pub struct Cell {
    pub row: i64
    pub col: i64
}

/// What a terminal's program did that the application hears about, as
/// `UiMsg::Terminal(terminal, event)`.
#[derive(PartialEq)]
pub enum Event {
    /// The program set the window title.
    Title(String)
    /// The program rang the bell.
    Bell
    /// The program exited with this status (128 + signal when killed).
    Exited(i64)
    /// The program could not be waited for.
    Failed(String)
    /// The program could not start once the screen was sized, so the
    /// terminal runs none.
    NotStarted(String)
    /// The screen could not take the size of its view within its byte limit,
    /// and keeps the size it has.
    Refused(String)
    /// The link under the pointer when a button last pressed on the screen,
    /// or empty when the press was off any link.
    LinkPointed(String)
    /// The user asked to open a link: Ctrl+click, or Command+click on macOS.
    LinkActivated(String)
    /// The program sent a desktop notification (OSC 9 or 777): its title,
    /// empty when it gave none, and its body.
    Notify(String, String)
    /// The program wrote this text to the clipboard (OSC 52). Programs can
    /// never read the clipboard back.
    Clipboard(String)
    /// The program wrote this text to the primary selection (OSC 52).
    PrimarySelection(String)
    /// The user asked to open a file path the screen shows: its absolute
    /// path and the line and column after it, 0 when it names none.
    PathActivated(String, i64, i64)
    /// A paste of several lines or of control characters waits for the
    /// application to confirm it (`ViewOptions::confirm_paste`); the
    /// application pastes the text with `Terminal::paste`.
    PasteHeld(String)
    /// The terminal's view took keyboard focus, as a click on it gives it.
    Focused
    /// What runs in front and where: the program name of the job in the
    /// terminal's foreground, empty while the program itself is in front
    /// (or where the system names no job), and the directory `cwd` reports.
    /// Sent once the program starts and again when either changes, as
    /// output arrives.
    Foreground(String, String)
}

/// A terminal's state.
pub struct Snapshot {
    pub rows: i64
    pub cols: i64
    pub cursor: Cell
    pub cursor_visible: bool
    pub alternate_screen: bool
    /// The visible screen, one line per row.
    pub text: String
    pub title: String
    pub running: bool
    pub exit: Option<i64>
    /// Rows the view is scrolled back into history.
    pub scrolled: i64
    /// Rows of history kept above the screen.
    pub history: i64
    pub selection: Option<(Cell, Cell)>
    pub reserved_bytes: i64
    pub pid: i64
    /// A job other than the program runs in the foreground, as a shell's
    /// command does; closing the terminal would end it.
    pub busy: bool
    /// The program name of that job, where the system names it.
    #[default]
    pub job: String
    pub queued_input: i64
    pub queued_output: i64
}

/// One row of a terminal's buffer as text: a wide character is one
/// character over two cells.
#[derive(Default, PartialEq)]
pub struct Row {
    pub text: String
    /// The row runs on into the next: the program's line continues there.
    pub wrapped: bool
}

/// A stretch of a terminal's buffer, its end excluded. Rows count from the
/// oldest history row, as `Terminal::rows` answers them, and columns are
/// cells.
#[derive(Default, PartialEq, Eq)]
pub struct Span {
    pub start: Cell
    pub end: Cell
}

/// What a stretch of the buffer is to the shell that marked it (OSC 133).
#[derive(PartialEq, Eq)]
pub enum ZoneKind {
    Prompt
    Input
    Output
}

/// A stretch of the buffer the shell marked, its end excluded, in the rows
/// `Terminal::rows` answers.
#[derive(PartialEq, Eq)]
pub struct Zone {
    pub kind: ZoneKind
    pub start: Cell
    pub end: Cell
}

/// A terminal's colors, each "#rrggbb": the default text and background,
/// the cursor, the selection and its text, and the sixteen named colors. A
/// color left empty, or that does not parse, takes the theme's.
#[derive(Default, PartialEq)]
pub struct Scheme {
    pub foreground: String
    pub background: String
    pub cursor: String
    pub selection: String
    pub selection_text: String
    pub ansi: Vec<String>
}

/// The widget showing terminal `terminal`. It fills the space it is given,
/// and the screen follows that size; `rows` and `cols` are the size it takes
/// where its parent sets no bound.
pub struct View {
    pub id: String
    pub terminal: i64
    /// The accessible name; the program's title is its description.
    pub label: String
    pub rows: i64
    pub cols: i64
    /// The font family; empty takes the bundled IBM Plex Mono, and a family
    /// that is not installed takes the bundled monospace face.
    pub font: String
    /// The text size in points; zero takes 10.
    pub font_size: f64
    /// The colors the screen shows; `None` takes the theme's.
    pub scheme: Option<Scheme>
    /// How the view draws and handles its terminal beyond font and colors.
    pub options: ViewOptions
}

/// How a view draws and handles its terminal beyond its font and colors.
#[derive(PartialEq)]
pub struct ViewOptions {
    /// The cursor's shape: "block", "bar" or "underline".
    pub cursor: String
    /// Whether the cursor blinks.
    pub blink: bool
    /// Bold text in the eight standard colors takes their bright forms.
    pub bold_bright: bool
    /// Letters too close to their background move toward a readable color.
    pub legible: bool
    /// Space around the screen, in interface units.
    pub padding: i64
    /// When the scrollbar shows: "always", "scrolling" (while the view is
    /// scrolled back) or "never".
    pub scrollbar: String
    /// Which edge the scrollbar lies along: "right" or "left".
    pub scrollbar_side: String
    /// New output brings a view scrolled back to the live screen.
    pub scroll_on_output: bool
    /// Typing brings a view scrolled back to the live screen.
    pub scroll_on_keystroke: bool
    /// Characters a double click selects along with letters and digits.
    pub word_chars: String
    /// On macOS, Option sends Meta (Escape and the key) rather than the
    /// character it types.
    pub option_as_meta: bool
    /// A selection is copied to the clipboard as well as the primary
    /// selection.
    pub copy_on_select: bool
    /// A paste of several lines or of control characters is held for the
    /// application to confirm (`Event::PasteHeld`).
    pub confirm_paste: bool
    /// The bell flashes the screen.
    pub flash_bell: bool
    /// How opaque the default background is, from 0 to 1; below 1 the
    /// application's windows must be see-through (`App::transparent`).
    pub opacity: f64
    /// The height of a row as a multiple of the font's line height, from 0.8
    /// to 3.
    pub line_height: f64
    /// The font's weight on the CSS scale (400 regular); bold text is 300
    /// heavier, from 700 to 900. The family's nearest faces draw it.
    pub font_weight: i64
    /// Whether letters of one style join into the font's ligatures, such as
    /// a coding font's arrows.
    pub ligatures: bool
}

/// What a double click selects besides letters and digits: enough for
/// paths, URLs and addresses.
pub const WORD_CHARS: String = "-#%&+,./:=?@_~"

impl Default for ViewOptions {
    fn default() -> ViewOptions {
        ViewOptions { cursor: "block", blink: true, bold_bright: false, legible: true, padding: 4, scrollbar: "never", scrollbar_side: "right", scroll_on_output: false, scroll_on_keystroke: true, word_chars: WORD_CHARS, option_as_meta: true, copy_on_select: false, confirm_paste: false, flash_bell: false, opacity: 1.0, line_height: 1.0, font_weight: 400, ligatures: true }
    }
}

/// A terminal handle.
#[derive(Default, PartialEq, Eq)]
pub struct Terminal {
    pub id: i64
}

enum Answer {
    Id(i64)
    Rows(i64)
    Text(String)
    Snapshot(Snapshot)
    Lines(Vec<Row>)
    Zones(Vec<Zone>)
    Done
}

fn call(method: String, id: i64, args: String) -> Result<Answer, errors::Error> {
    let answer = gui_engine::terminal(method, id, args).map_err(|why| errors::new(why))?
    json::decode::<Answer>(answer)
}

fn done(answer: Result<Answer, errors::Error>) -> Result<(), errors::Error> {
    answer.map(|_| ())
}

impl Terminal {
    /// Opens a terminal in the running session.
    pub fn open(options: Options = Options { rows: 24, cols: 80, scrollback: 2_000, byte_limit: 67_108_864 }) -> Result<Terminal, errors::Error> {
        match call("open", 0, json::encode(options))? {
            Answer::Id(id) => Ok(Terminal { id: id })
            _ => Err(errors::new("invalid terminal identity answer"))
        }
    }

    /// Runs `command` on the terminal; its output arrives as the session
    /// runs, and `Event::Exited` reports its end. The program starts once a
    /// view or `resize` sizes the screen, so it starts at that size; a
    /// terminal no view shows (a tab in the back of a window) starts after a
    /// short wait, at the size a view last gave the session's terminals.
    pub fn spawn(&self, command: Command) -> Result<(), errors::Error> {
        done(call("spawn", self.id, json::encode(command)))
    }

    /// Shows `text` as program output: a recorded stream, or output the
    /// application writes itself.
    pub fn feed(&self, text: String) -> Result<(), errors::Error> {
        done(call("feed", self.id, json::encode(text)))
    }

    /// Sends `text` to the program as typed input.
    pub fn input(&self, text: String) -> Result<(), errors::Error> {
        done(call("input", self.id, json::encode(text)))
    }

    /// Pastes `text`, bracketed when the program asked for bracketed paste.
    pub fn paste(&self, text: String) -> Result<(), errors::Error> {
        done(call("paste", self.id, json::encode(text)))
    }

    /// Sends signal `signum` to the job in the terminal's foreground, or to
    /// the program when nothing else runs there. Windows has no signals and
    /// refuses.
    pub fn signal(&self, signum: i64) -> Result<(), errors::Error> {
        done(call("signal", self.id, json::encode(signum)))
    }

    /// Sets the character set the program reads and writes, from its next
    /// output on: a label such as "ISO-8859-1", "windows-1251" or
    /// "Shift_JIS". "UTF-8" is the default.
    pub fn set_encoding(&self, label: String) -> Result<(), errors::Error> {
        done(call("encoding", self.id, json::encode(label)))
    }

    pub fn resize(&self, rows: i64, cols: i64) -> Result<(), errors::Error> {
        done(call("resize", self.id, json::encode((rows, cols))))
    }

    /// Scrolls `rows` rows back into history (negative moves forward),
    /// answering how far back the view now is.
    pub fn scroll(&self, rows: i64) -> Result<i64, errors::Error> {
        match call("scroll", self.id, json::encode(rows))? {
            Answer::Rows(n) => Ok(n)
            _ => Err(errors::new("invalid terminal scroll answer"))
        }
    }

    /// Selects from `anchor` to `caret`.
    pub fn select(&self, anchor: Cell, caret: Cell) -> Result<(), errors::Error> {
        done(call("select", self.id, json::encode((anchor, caret))))
    }

    pub fn clear_selection(&self) -> Result<(), errors::Error> {
        done(call("deselect", self.id, "null"))
    }

    /// The selected text, empty without a selection.
    pub fn copy(&self) -> Result<String, errors::Error> {
        match call("copy", self.id, "null")? {
            Answer::Text(text) => Ok(text)
            _ => Err(errors::new("invalid terminal copy answer"))
        }
    }

    /// Writes the terminal's text to the file at `path` as UTF-8: the
    /// selection when `selection` is set, otherwise every row it keeps,
    /// oldest first, each wrapped row joined into its line. Answers the bytes
    /// written.
    pub fn save_text(&self, path: String, selection: bool) -> Result<i64, errors::Error> {
        match call("save_text", self.id, json::encode((path, selection)))? {
            Answer::Rows(n) => Ok(n)
            _ => Err(errors::new("invalid terminal save answer"))
        }
    }

    /// Starts copy mode: keys move a cursor of its own over the screen and
    /// the history, `v` or Space starts a selection, `y` or Enter copies it
    /// (the cursor's line without one), and Escape or `q` ends the mode.
    pub fn copy_mode(&self) -> Result<(), errors::Error> {
        done(call("copy_mode", self.id, "null"))
    }

    /// Labels each link on the screen; typing a label opens that link, or
    /// copies it when `copy` is set. Answers how many links there are: with
    /// none, no labels show.
    pub fn hints(&self, copy: bool) -> Result<i64, errors::Error> {
        match call("hints", self.id, json::encode(copy))? {
            Answer::Rows(n) => Ok(n)
            _ => Err(errors::new("invalid terminal hints answer"))
        }
    }

    /// Ends copy mode or the link hints.
    pub fn leave_mode(&self) -> Result<(), errors::Error> {
        done(call("leave_mode", self.id, "null"))
    }

    pub fn snapshot(&self) -> Result<Snapshot, errors::Error> {
        match call("snapshot", self.id, "null")? {
            Answer::Snapshot(shown) => Ok(shown)
            _ => Err(errors::new("invalid terminal snapshot answer"))
        }
    }

    /// Every row of the buffer, the oldest history row first, wherever the
    /// view is scrolled; the last `Snapshot::rows` rows are the screen.
    pub fn rows(&self) -> Result<Vec<Row>, errors::Error> {
        match call("rows", self.id, "null")? {
            Answer::Lines(rows) => Ok(rows)
            _ => Err(errors::new("invalid terminal rows answer"))
        }
    }

    /// Every match of `query` in the buffer, history included, in order. A
    /// match may run on across the rows a program's line wrapped onto.
    pub fn find(&self, query: String, options: SearchOptions) -> Result<Vec<Span>, errors::Error> {
        let mut out = #[]
        if query.is_empty() {
            return Ok(out)
        }
        let searcher = Searcher::new(query, options).map_err(|why| errors::new(why))?
        let rows = self.rows()?
        let mut first = 0
        while first < rows.len() && out.len() < MATCH_LIMIT {
            let mut last = first
            while last + 1 < rows.len() && rows[last].wrapped { last += 1 }
            let mut line = String::new()
            let mut starts = #[]
            for at in first..last + 1 {
                starts.push(line.byte_len())
                line += rows[at].text
            }
            for found in searcher.find_all(line, MATCH_LIMIT - out.len()) {
                out.push(Span {
                    start: cell_of(rows, first, starts, found.start.0, false)
                    end: cell_of(rows, first, starts, found.end.0, true)
                })
            }
            first = last + 1
        }
        Ok(out)
    }

    /// The directory the program works in: the one it last reported (OSC 7),
    /// else the foreground job's, else the program's own. Empty when none is
    /// known, as on Windows for a program that reports none.
    pub fn cwd(&self) -> Result<String, errors::Error> {
        match call("cwd", self.id, "null")? {
            Answer::Text(path) => Ok(path)
            _ => Err(errors::new("invalid terminal directory answer"))
        }
    }

    /// The stretches of the buffer the shell marked as prompts, inputs and
    /// outputs, oldest first; empty for a shell that marks none.
    pub fn zones(&self) -> Result<Vec<Zone>, errors::Error> {
        match call("zones", self.id, "null")? {
            Answer::Zones(zones) => Ok(zones)
            _ => Err(errors::new("invalid terminal zones answer"))
        }
    }

    /// Shows `spans` of the buffer highlighted, as a weaker selection,
    /// replacing any it showed.
    pub fn set_highlights(&self, spans: Vec<Span>) -> Result<(), errors::Error> {
        done(call("highlight", self.id, json::encode(spans)))
    }

    pub fn clear_highlight(&self) -> Result<(), errors::Error> {
        self.set_highlights(#[])
    }

    /// Scrolls the view so buffer row `row` is its top row, as far as the
    /// history allows.
    pub fn scroll_to_row(&self, row: i64) -> Result<(), errors::Error> {
        let shown = self.snapshot()?
        let top = row.clamp(0, shown.history)
        self.scroll(shown.history - top - shown.scrolled).map(|_| ())
    }

    /// Scrolls `span` into view, a third of the way down where the history
    /// allows, and selects it.
    pub fn reveal(&self, span: Span) -> Result<(), errors::Error> {
        let shown = self.snapshot()?
        let top = (span.start.row - shown.rows / 3).clamp(0, shown.history)
        let back = shown.history - top
        self.scroll(back - shown.scrolled)?
        self.select(Cell { row: span.start.row - top, col: span.start.col }, Cell { row: span.end.row - top, col: span.end.col })
    }

    /// Resets what a program may have left the terminal in - the alternate
    /// screen, scroll margins, colors and attributes, character sets, modes,
    /// mouse and keyboard reporting, cursor shape - while the screen keeps its
    /// text and history, so the program goes on where it was (a shell's prompt
    /// stays usable). Shows the live screen without a selection.
    pub fn reset(&self) -> Result<(), errors::Error> {
        self.feed(SOFT_RESET.join(""))?
        self.clear_selection()?
        let back = self.snapshot()?.scrolled
        self.scroll(-back).map(|_| ())
    }

    /// Erases the history above the screen and shows the live screen; the
    /// screen keeps what it shows.
    pub fn clear_scrollback(&self) -> Result<(), errors::Error> {
        self.feed("\u{1b}[3J")?
        let back = self.snapshot()?.scrolled
        self.scroll(-back).map(|_| ())
    }

    /// Ends the program, if any, and releases the terminal.
    pub fn close(&self) {
        let _ = call("close", self.id, "null")
    }

    /// The widget showing this terminal.
    pub fn view(&self, id: String, label: String, rows: i64 = 24, cols: i64 = 80, font: String = "", font_size: f64 = 0.0, scheme: Option<Scheme> = None, options: Option<ViewOptions> = None) -> crate::Widget {
        crate::Widget::Terminal(View { id: id, terminal: self.id, label: label, rows: rows, cols: cols, font: font, font_size: font_size, scheme: scheme, options: options.unwrap_or(ViewOptions::default()) })
    }
}

// The cell at byte `at` of a program line made of rows `first..`, where
// `starts` holds each row's byte offset in the line. An `end` offset on a
// row boundary closes the row before it.
fn cell_of(rows: Vec<Row>, first: i64, starts: Vec<i64>, at: i64, end: bool) -> Cell {
    let mut k = 0
    while k + 1 < starts.len() && (starts[k + 1] < at || (!end && starts[k + 1] == at)) { k += 1 }
    let text = rows[first + k].text
    let within = (at - starts[k]).min(text.byte_len())
    Cell { row: first + k, col: unicode::str_width(text.substring(0, within)) }
}
