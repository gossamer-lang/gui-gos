use std::encoding::json
use gui_engine

use crate::style::Theme
use crate::style::color::Color

/// Lexical category for a source byte range.
#[derive(PartialEq, Eq)]
pub enum Kind {
    Keyword
    StringLiteral
    Comment
    Number
    TypeName
    Function
}

/// A sorted, non-overlapping source byte range.
#[derive(PartialEq)]
pub struct Span {
    pub start: i64
    pub end: i64
    pub kind: Kind
}

/// A cached line with its outgoing multiline lexical state.
#[derive(PartialEq)]
pub struct SourceLine {
    pub text: String
    pub spans: Vec<Span>
    pub words: Vec<String>
    pub incoming: i64
    pub outgoing: i64
}

/// Revision-aware source analysis shared by painting, completion, and status.
#[derive(PartialEq)]
pub struct Document {
    pub text: String
    pub language: String
    pub lines: Vec<SourceLine>
    pub spans: Vec<Span>
    pub words: Vec<String>
    /// Lines lexed during the latest update.
    pub scanned: i64
    pub error: String
}

impl Document {
    pub fn empty(language: String) -> Document {
        Document { text: "", language: language, lines: #[SourceLine { text: "", spans: #[], words: #[], incoming: 0, outgoing: 0 }], spans: #[], words: #[], scanned: 0, error: "" }
    }

    /// Bounded synchronous convenience for small documents. Application IO and
    /// analysis should use services::work::Operation::Analyze.
    pub fn new(text: String, language: String) -> Document {
        let mut document = Document::empty(language)
        document.update(text)
        document
    }

    pub fn update(&mut self, text: String) {
        let encoded = gui_engine::analyze(json::encode(*self), text)
        match encoded {
            Ok(value) => {
                match json::decode::<Document>(value) {
                    Ok(document) => *self = document
                    Err(error) => { *self = Document::empty(self.language); self.error = f"{error}" }
                }
            }
            Err(error) => { *self = Document::empty(self.language); self.error = error }
        }
    }
}
/// The language a file's extension names, for `Document::new`: a code
/// language the lexer colors, or "text" for plain text.
pub fn language_for(path: String) -> String {
    let dot = path.rfind(".").unwrap_or(-1)
    let slash = path.rfind("/").unwrap_or(-1)
    if dot <= slash + 1 {
        return "text"
    }
    let ext = path.substring(dot + 1, path.byte_len()).to_lowercase()
    if CODE_LANGUAGES.contains(ext) { ext } else { "text" }
}

// Extensions of the C-family and Python-like languages the lexer colors.
const CODE_LANGUAGES: [String; 14] = ["gos", "rs", "c", "h", "cc", "cpp", "hpp", "go", "java", "js", "ts", "swift", "kt", "py"]

/// Resolves syntax colors against the current theme at paint time.
pub fn color(kind: Kind, theme: Theme) -> Color {
    let dark = theme.field.luminance() < 0.3
    match kind {
        Kind::Keyword => if dark { Color::hex(0xc792ea) } else { Color::hex(0x7830a5) }
        Kind::StringLiteral => if dark { Color::hex(0xc3e88d) } else { Color::hex(0x286b24) }
        Kind::Comment => theme.text_muted
        Kind::Number => if dark { Color::hex(0xf7b267) } else { Color::hex(0x994500) }
        Kind::TypeName => if dark { Color::hex(0xffcb6b) } else { Color::hex(0x865900) }
        Kind::Function => if dark { Color::hex(0x82aaff) } else { Color::hex(0x135c9b) }
    }
}

#[cfg(test)]
mod tests {
    #[test]
    fn plain_text_has_no_colors_and_extensions_pick_the_language() {
        let d = super::Document::new("Dragged from the widget showcase.", super::language_for("/tmp/notes.txt"))
        assert(d.spans.is_empty())
        assert(d.words.contains("Dragged"))
        assert_eq(super::language_for("src/main.gos"), "gos")
        assert_eq(super::language_for("/tmp/Script.PY"), "py")
        assert_eq(super::language_for("/tmp/.bashrc"), "text")
        assert_eq(super::language_for("/home/a.b/README"), "text")
    }

    #[test]
    fn syntax_offsets_are_utf8_bytes_and_comment_state_converges() {
        let mut d = super::Document::new("let café = \"é\"\n/* start\ninside\n*/ fn done() {}", "gos")
        assert_eq(d.lines.len(), 4)
        assert_eq(d.lines[1].outgoing, 1)
        assert_eq(d.lines[3].outgoing, 0)
        assert_eq(d.text.substring(d.spans[1].start, d.spans[1].end), "\"é\"")
        d.update("let café = \"é\"\n// start\ninside\n*/ fn done() {}")
        assert_eq(d.scanned, 3)
        assert_eq(d.lines[2].spans.len(), 0)
        d.update("let café = \"é\"\n// start\ninside\n*/ fn done() {}")
        assert_eq(d.scanned, 0)
    }

    #[test]
    fn unchanged_lines_are_reused_after_insertion() {
        let mut d = super::Document::new("fn first() {}\nfn second() {}", "gos")
        d.update("// heading\nfn first() {}\nfn second() {}")
        assert_eq(d.scanned, 1)
        assert_eq(d.text.substring(d.spans[1].start, d.spans[1].end), "fn")
    }
}
