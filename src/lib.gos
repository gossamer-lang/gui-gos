// gui: a desktop GUI toolkit for Gossamer on windowing-gos.
//
// An application is a model, an update function folding messages into
// it, and a view function building the widget tree from it:
//
//     use gui
//     use gui::{UiMsg, Widget}
//
//     fn update(count: i64, msg: UiMsg) -> i64 {
//         match msg {
//             UiMsg::Click(id) => if id == "more" { count + 1 } else { count }
//             _ => count
//         }
//     }
//
//     fn view(count: i64) -> Widget {
//         Widget::column(#[Widget::label(f"Clicked {count} times"), Widget::button("more", "Click")], 8).padding(16)
//     }
//
//     fn main() -> Result<(), errors::Error> {
//         gui::application("Counter", "dev.example.counter", || 0, update, view).run()
//     }
//
// Everything that would need a session handle in `update` (dialogs,
// background tasks, timers, focus, clipboard) is requested with
// `gui::perform(Effect::...)`.

use std::{env, errors, fs}

use crate::{accessibility, commands, dialogs, editing, geometry, input, services, style, text, widgets}

